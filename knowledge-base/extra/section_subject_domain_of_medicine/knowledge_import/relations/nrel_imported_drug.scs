nrel_imported_drug
<- sc_node_non_role_relation;
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
=> nrel_main_idtf:
	[загруженный препарат*] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[imported drug*] (* <- lang_en;; *);
=> nrel_first_domain:
	concept_message;
=> nrel_second_domain:
	concept_drug;
=> nrel_definition:
	[бинарное ориентированное отношение, связывающее сообщение пользователя с лекарственными средствами, сведения о которых агент загрузил при обработке этого сообщения] (* <- lang_ru;; *);;
