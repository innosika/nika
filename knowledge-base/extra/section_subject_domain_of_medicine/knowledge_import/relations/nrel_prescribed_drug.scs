nrel_prescribed_drug
<- sc_node_non_role_relation;
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
=> nrel_main_idtf:
	[назначаемый препарат*] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[prescribed drug*] (* <- lang_en;; *);
=> nrel_first_domain:
	concept_physician;
=> nrel_second_domain:
	concept_drug;
=> nrel_definition:
	[бинарное ориентированное отношение, связывающее врача с лекарственным средством, показанным при заболеваниях его профиля (выводится правилом)] (* <- lang_ru;; *);;
