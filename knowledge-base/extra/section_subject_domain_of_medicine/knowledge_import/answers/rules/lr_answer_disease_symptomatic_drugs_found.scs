/* Правило ответа на сообщение о симптоматическом лечении заболевания: сведения есть. Автор: бригада. */

@if_lr_answer_disease_symptomatic_drugs_found = [*
	concept_message _-> _message;;
	_message _-> rrel_entity:: _entity;;
	_drug _=> nrel_symptomatic_treatment:: _entity;;
	concept_message_about_disease_symptomatic_drugs _-> _message;;
*];;
@then_lr_answer_disease_symptomatic_drugs_found = [*
	_message _=> nrel_reply:: _reply_message;;
	concept_atomic_message _-> _reply_message;;
*];;
@if_lr_answer_disease_symptomatic_drugs_found <- atomic_logical_formula;;
@then_lr_answer_disease_symptomatic_drugs_found <- atomic_logical_formula;;
@impl_lr_answer_disease_symptomatic_drugs_found = (@if_lr_answer_disease_symptomatic_drugs_found => @then_lr_answer_disease_symptomatic_drugs_found);;
@impl_lr_answer_disease_symptomatic_drugs_found <- nrel_implication;;
answer_pattern_lr_answer_disease_symptomatic_drugs_found
<- sc_node_tuple;
-> rrel_1: concept_phrase_about_disease_symptomatic_drugs_found;;
lr_answer_disease_symptomatic_drugs_found
<- concept_answer_on_standard_message_rule;
<- concept_answer_on_standard_message_rule_priority_2;
=> nrel_main_idtf:
	[правило ответа на сообщение о симптоматическом лечении заболевания: сведения есть] (* <- lang_ru;; *);
=> nrel_answer_pattern: answer_pattern_lr_answer_disease_symptomatic_drugs_found;
-> rrel_main_key_sc_element: @impl_lr_answer_disease_symptomatic_drugs_found;;
