concept_phrase_about_disease_symptomatic_drugs_found
<- sc_node_class;
=> nrel_main_idtf:
	[фраза о симптоматическом лечении заболевания: сведения есть] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[phrase about symptomatic drugs: found] (* <- lang_en;; *);
<= nrel_inclusion:
	concept_phrase_about_drug_knowledge;;

@template_phrase_about_disease_symptomatic_drugs_found_1 = [*
	concept_message _-> _message;;
	_message _-> rrel_entity:: _entity;;
	_entity _=> nrel_main_idtf:: _entity_name;;
	lang_ru _-> _entity_name;;
	_drug _=> nrel_symptomatic_treatment:: _entity;;
*];;
@phrase_about_disease_symptomatic_drugs_found_1 = [Для облегчения симптомов заболевания «${_entity_name}» применяют: $list{_drug}.];;
@phrase_about_disease_symptomatic_drugs_found_1
<- lang_ru;
<- concept_phrase_about_disease_symptomatic_drugs_found;
=> nrel_phrase_template: @template_phrase_about_disease_symptomatic_drugs_found_1;;

@template_phrase_about_disease_symptomatic_drugs_found_2 = [*
	concept_message _-> _message;;
	_message _-> rrel_entity:: _entity;;
	_entity _=> nrel_main_idtf:: _entity_name;;
	lang_ru _-> _entity_name;;
	_drug _=> nrel_symptomatic_treatment:: _entity;;
*];;
@phrase_about_disease_symptomatic_drugs_found_2 = [Симптомы заболевания «${_entity_name}» снимают препараты: $list{_drug}.];;
@phrase_about_disease_symptomatic_drugs_found_2
<- lang_ru;
<- concept_phrase_about_disease_symptomatic_drugs_found;
=> nrel_phrase_template: @template_phrase_about_disease_symptomatic_drugs_found_2;;
