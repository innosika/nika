concept_phrase_about_doctor_prescribed_drugs_found
<- sc_node_class;
=> nrel_main_idtf:
	[фраза о препаратах, которые назначает врач: сведения есть] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[phrase about prescribed drugs: found] (* <- lang_en;; *);
<= nrel_inclusion:
	concept_phrase_about_drug_knowledge;;

@template_phrase_about_doctor_prescribed_drugs_found_1 = [*
	concept_message _-> _message;;
	_message _-> rrel_entity:: _entity;;
	_entity _=> nrel_main_idtf:: _entity_name;;
	lang_ru _-> _entity_name;;
	_entity _=> nrel_prescribed_drug:: _drug;;
*];;
@phrase_about_doctor_prescribed_drugs_found_1 = [По базе знаний «${_entity_name}» назначает препараты: $list{_drug}.];;
@phrase_about_doctor_prescribed_drugs_found_1
<- lang_ru;
<- concept_phrase_about_doctor_prescribed_drugs_found;
=> nrel_phrase_template: @template_phrase_about_doctor_prescribed_drugs_found_1;;

@template_phrase_about_doctor_prescribed_drugs_found_2 = [*
	concept_message _-> _message;;
	_message _-> rrel_entity:: _entity;;
	_entity _=> nrel_main_idtf:: _entity_name;;
	lang_ru _-> _entity_name;;
	_entity _=> nrel_prescribed_drug:: _drug;;
*];;
@phrase_about_doctor_prescribed_drugs_found_2 = [Врач «${_entity_name}» может назначить: $list{_drug}.];;
@phrase_about_doctor_prescribed_drugs_found_2
<- lang_ru;
<- concept_phrase_about_doctor_prescribed_drugs_found;
=> nrel_phrase_template: @template_phrase_about_doctor_prescribed_drugs_found_2;;
