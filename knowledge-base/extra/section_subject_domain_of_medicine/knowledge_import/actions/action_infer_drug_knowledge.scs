/* Класс действий агента DrugKnowledgeInferenceAgent. */
action_infer_drug_knowledge
<- sc_node_class;
<- actions_class;
<- atomic_action_class;
=> nrel_main_idtf:
	[действие. вывести новые знания о лекарственных средствах] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[action. infer drug knowledge] (* <- lang_en;; *);
<= nrel_inclusion:
	information_action;
=> nrel_definition:
	[действие, в ходе которого агент применяет логические правила набора concept_drug_knowledge_rule к базе знаний и порождает новые факты] (* <- lang_ru;; *);;

/* Спецификация абстрактного sc-агента DrugKnowledgeInferenceAgent (C++, scl-machine; автор — бригада). */
@agent_infer_drug_knowledge_condition = [*
		action_infer_drug_knowledge _-> _action;;
		action_initiated _-> _action;;
		_action _-> rrel_1:: _drugs;;
*];;
@agent_infer_drug_knowledge_result = [*
		_action _=> nrel_result:: _result;;
		_result _-> _output_structure;;
		_result _-> _count;;
*];;
@agent_infer_drug_knowledge_condition_and_result = (@agent_infer_drug_knowledge_condition => @agent_infer_drug_knowledge_result);;
agent_infer_drug_knowledge
<- abstract_sc_agent;
=> nrel_main_idtf:
	[агент вывода новых знаний о лекарственных средствах] (* <- lang_ru;; *);
	[DrugKnowledgeInferenceAgent] (* <- lang_en;; *);
=> nrel_primary_initiation_condition:
	(sc_event_after_generate_outgoing_arc => action_initiated);
=> nrel_sc_agent_action_class:
	action_infer_drug_knowledge;
=> nrel_initiation_condition_and_result:
	@agent_infer_drug_knowledge_condition_and_result;
=> nrel_note:
	[реализация: problem-solver/cxx/drug-knowledge-module/] (* <- lang_ru;; *);
=> nrel_note:
	[входы: rrel_1 — множество препаратов, сведения о которых только что погружены (для журнала); правила применяются ко всей базе знаний] (* <- lang_ru;; *);
=> nrel_note:
	[выходы: выведенные факты: класс препарата, симптоматическое лечение*, назначаемый препарат*, применяемое лекарственное средство*; результат — структуры с фактами и ссылка с их числом] (* <- lang_ru;; *);
=> nrel_note:
	[процедуры: прямой логический вывод scl-machine (DirectInferenceManagerAll: GENERATE_UNIQUE_FORMULAS, REPLACEMENTS_ALL, SEARCH_IN_ALL_KB) по упорядоченному набору правил; повтор, пока появляются новые факты; подсчёт выведенных фактов] (* <- lang_ru;; *);;
