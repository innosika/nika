/* Класс действий агента DrugKbFillByTypeAgent. */
action_fill_kb_with_drugs_by_type
<- sc_node_class;
<- actions_class;
<- atomic_action_class;
=> nrel_main_idtf:
	[действие. наполнить базу знаний лекарственными средствами заданного типа] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[action. fill knowledge base with drugs of a given type] (* <- lang_en;; *);
<= nrel_inclusion:
	information_action;
=> nrel_definition:
	[действие, в ходе которого агент загружает лекарственные средства заданного класса или применяемые при заданном заболевании (классе заболеваний)] (* <- lang_ru;; *);;

/* Спецификация абстрактного sc-агента DrugKbFillByTypeAgent (Python; автор — Рублевская Е.). */
@agent_fill_kb_with_drugs_by_type_condition = [*
		action_fill_kb_with_drugs_by_type _-> _action;;
		action_initiated _-> _action;;
		_action _-> rrel_1:: _message;;
		concept_message_about_kb_filling_with_drugs _-> _message;;
		_message _-> rrel_entity:: _type;;
*];;
@agent_fill_kb_with_drugs_by_type_result = [*
		concept_message_about_kb_filling_with_drugs_by_type _-> _message;;
		_drug _=> nrel_indication:: _disease;;
		_message _=> nrel_imported_drug:: _drug;;
		_message _=> nrel_knowledge_import_report:: _report;;
*];;
@agent_fill_kb_with_drugs_by_type_condition_and_result = (@agent_fill_kb_with_drugs_by_type_condition => @agent_fill_kb_with_drugs_by_type_result);;
agent_fill_kb_with_drugs_by_type
<- abstract_sc_agent;
=> nrel_main_idtf:
	[агент наполнения базы знаний лекарственными средствами заданного типа] (* <- lang_ru;; *);
	[DrugKbFillByTypeAgent] (* <- lang_en;; *);
=> nrel_primary_initiation_condition:
	(sc_event_after_generate_outgoing_arc => action_initiated);
=> nrel_sc_agent_action_class:
	action_fill_kb_with_drugs_by_type;
=> nrel_initiation_condition_and_result:
	@agent_fill_kb_with_drugs_by_type_condition_and_result;
=> nrel_note:
	[реализация: problem-solver/py/modules/drugImportModule/DrugKbFillByTypeAgent.py] (* <- lang_ru;; *);
=> nrel_note:
	[входы: rrel_1 — сообщение «о наполнении базы знаний лекарственными средствами» с сущностью: классом лекарственных средств, заболеванием или классом заболеваний] (* <- lang_ru;; *);
=> nrel_note:
	[выходы: лекарственные средства заданного типа со сведениями; загруженные препараты* и отчёт в сообщении] (* <- lang_ru;; *);
=> nrel_note:
	[процедуры: определение типа по сущности; для класса лекарств — группы ATC класса и подклассов, состав групп из RxClass; для заболевания — рубрики MeSH (для класса — всех его заболеваний), лекарства MED-RT may_treat; загрузка, погружение и вывод] (* <- lang_ru;; *);;
