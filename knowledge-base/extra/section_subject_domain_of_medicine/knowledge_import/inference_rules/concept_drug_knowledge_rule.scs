/* Набор правил вывода новых знаний о лекарственных средствах (агент DrugKnowledgeInferenceAgent).
   Упорядоченное множество классов правил по приоритету, как у правил классификации сообщений:
   сначала выводится класс препарата — он нужен правилам второго приоритета. */

concept_drug_knowledge_rule
<- sc_node_class;
=> nrel_main_idtf:
	[множество правил вывода знаний о лекарственных средствах] (* <- lang_ru;; *);
	[set of rules for inferring knowledge about drugs] (* <- lang_en;; *);;

concept_drug_knowledge_rule_priority_1
<- sc_node_class;
=> nrel_main_idtf:
	[правила вывода знаний о лекарственных средствах первого приоритета] (* <- lang_ru;; *);;

concept_drug_knowledge_rule_priority_2
<- sc_node_class;
=> nrel_main_idtf:
	[правила вывода знаний о лекарственных средствах второго приоритета] (* <- lang_ru;; *);;

@drug_rule_access_arc_1 = (concept_drug_knowledge_rule -> rrel_1: concept_drug_knowledge_rule_priority_1);;
@drug_rule_access_arc_2 = (concept_drug_knowledge_rule -> concept_drug_knowledge_rule_priority_2);;
@drug_rule_sequence_arc = (@drug_rule_access_arc_1 => @drug_rule_access_arc_2);;
nrel_basic_sequence -> @drug_rule_sequence_arc;;
