<- sc_node_class;
=> nrel_main_idtf:
	[сообщение о препаратах для симптоматического лечения заболевания] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[message about drugs for symptomatic treatment of a disease] (* <- lang_en;; *);
=> nrel_wit_ai_idtf:
