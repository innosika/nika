allergist
<- concept_therapeutic_physician;
<- concept_wit_entity;
=> nrel_main_idtf:
	[врач аллерголог-иммунолог] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[allergist] (* <- lang_en;; *);
=> nrel_idtf:
	[аллерголог] (* <- lang_ru;; *);
=> nrel_idtf:
	[аллерголог-иммунолог] (* <- lang_ru;; *);
=> nrel_definition:
	[врач терапевтического профиля, занимающийся диагностикой и лечением аллергических заболеваний] (* <- lang_ru;; *);;

antihistamine_therapy
<- concept_pathogenetic_therapy;
<- concept_wit_entity;
=> nrel_main_idtf:
	[антигистаминная терапия] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[antihistamine therapy] (* <- lang_en;; *);
=> nrel_idtf:
