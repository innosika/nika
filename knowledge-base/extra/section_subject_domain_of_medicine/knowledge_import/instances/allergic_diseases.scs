=> nrel_definition:
	[патогенетическая терапия аллергических заболеваний антигистаминными средствами] (* <- lang_ru;; *);;

allergic_rhinitis
<- concept_allergic_disease;
<- concept_wit_entity;
=> nrel_main_idtf:
	[аллергический ринит] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[allergic rhinitis] (* <- lang_en;; *);
=> nrel_idtf:
	[сенная лихорадка] (* <- lang_ru;; *);
=> nrel_idtf:
	[поллиноз] (* <- lang_ru;; *);
=> nrel_definition:
	[аллергическое воспаление слизистой оболочки носа при контакте с аллергеном — пыльцой, пылью, шерстью животных] (* <- lang_ru;; *);
=> nrel_icd_code:
	[J30.4];
=> nrel_symptom:
	sneezing;
=> nrel_symptom:
	rhinorrhea;
=> nrel_symptom:
	nasal_congestion;
=> nrel_symptom:
	itching;
=> nrel_treatment_method:
	antihistamine_therapy;
=> nrel_treatment_method:
	glucocorticoid_therapy;
=> nrel_specialist:
	allergist;
=> nrel_mesh_heading:
	[Rhinitis, Allergic];
=> nrel_mesh_heading:
	[Rhinitis, Allergic, Perennial];
=> nrel_mesh_heading:
	[Rhinitis, Allergic, Seasonal];;

