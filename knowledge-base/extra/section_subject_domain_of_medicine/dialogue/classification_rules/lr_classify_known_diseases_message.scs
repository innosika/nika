/* «Какие заболевания ты знаешь?» — вопрос о разбиении класса заболевание.
   Точные формулировки: «Какие заболевания ты знаешь?»; «Какие болезни ты знаешь?»; «Какие бывают болезни?». */

@if_lr_classify_known_diseases_message_1 = [*
	_message <-_ concept_message;;
	_translation_lr_classify_known_diseases_message _=> nrel_sc_text_translation:: _message;;
	_translation_lr_classify_known_diseases_message _-> _text_lr_classify_known_diseases_message_1;;
	_text_lr_classify_known_diseases_message_1 = _[Какие заболевания ты знаешь?];;
*];;

@if_lr_classify_known_diseases_message_2 = [*
	_message <-_ concept_message;;
	_translation_lr_classify_known_diseases_message _=> nrel_sc_text_translation:: _message;;
	_translation_lr_classify_known_diseases_message _-> _text_lr_classify_known_diseases_message_2;;
	_text_lr_classify_known_diseases_message_2 = _[Какие болезни ты знаешь?];;
*];;

@if_lr_classify_known_diseases_message_3 = [*
	_message <-_ concept_message;;
	_translation_lr_classify_known_diseases_message _=> nrel_sc_text_translation:: _message;;
	_translation_lr_classify_known_diseases_message _-> _text_lr_classify_known_diseases_message_3;;
	_text_lr_classify_known_diseases_message_3 = _[Какие бывают болезни?];;
*];;

@then_lr_classify_known_diseases_message = [*
	concept_message_about_subdividing _-> _message;;
	_message _-> rrel_entity:: concept_disease;;
*];;

@if_lr_classify_known_diseases_message_1 <- atomic_logical_formula; <- concept_template_with_links;;
@if_lr_classify_known_diseases_message_2 <- atomic_logical_formula; <- concept_template_with_links;;
@if_lr_classify_known_diseases_message_3 <- atomic_logical_formula; <- concept_template_with_links;;
@then_lr_classify_known_diseases_message <- atomic_logical_formula;;

@or_lr_classify_known_diseases_message = { @if_lr_classify_known_diseases_message_1; @if_lr_classify_known_diseases_message_2; @if_lr_classify_known_diseases_message_3 };;
@or_lr_classify_known_diseases_message <- nrel_disjunction;;
@impl_lr_classify_known_diseases_message = (@or_lr_classify_known_diseases_message => @then_lr_classify_known_diseases_message);;
@impl_lr_classify_known_diseases_message <- nrel_implication;;

lr_classify_known_diseases_message
<- concept_classify_message_rule_priority_1;
=> nrel_main_idtf:
	[правило классификации: Какие заболевания ты знаешь?] (* <- lang_ru;; *);
-> rrel_main_key_sc_element: @impl_lr_classify_known_diseases_message;;
