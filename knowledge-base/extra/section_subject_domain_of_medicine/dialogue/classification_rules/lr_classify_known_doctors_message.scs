/* «Какие врачи бывают?» — вопрос о разбиении класса врач.
   Точные формулировки: «Какие врачи бывают?»; «Какие бывают врачи?»; «Каких врачей ты знаешь?». */

@if_lr_classify_known_doctors_message_1 = [*
	_message <-_ concept_message;;
	_translation_lr_classify_known_doctors_message _=> nrel_sc_text_translation:: _message;;
	_translation_lr_classify_known_doctors_message _-> _text_lr_classify_known_doctors_message_1;;
	_text_lr_classify_known_doctors_message_1 = _[Какие врачи бывают?];;
*];;

@if_lr_classify_known_doctors_message_2 = [*
	_message <-_ concept_message;;
	_translation_lr_classify_known_doctors_message _=> nrel_sc_text_translation:: _message;;
	_translation_lr_classify_known_doctors_message _-> _text_lr_classify_known_doctors_message_2;;
	_text_lr_classify_known_doctors_message_2 = _[Какие бывают врачи?];;
*];;

@if_lr_classify_known_doctors_message_3 = [*
	_message <-_ concept_message;;
	_translation_lr_classify_known_doctors_message _=> nrel_sc_text_translation:: _message;;
	_translation_lr_classify_known_doctors_message _-> _text_lr_classify_known_doctors_message_3;;
	_text_lr_classify_known_doctors_message_3 = _[Каких врачей ты знаешь?];;
*];;

@then_lr_classify_known_doctors_message = [*
	concept_message_about_subdividing _-> _message;;
	_message _-> rrel_entity:: concept_physician;;
*];;

@if_lr_classify_known_doctors_message_1 <- atomic_logical_formula; <- concept_template_with_links;;
@if_lr_classify_known_doctors_message_2 <- atomic_logical_formula; <- concept_template_with_links;;
@if_lr_classify_known_doctors_message_3 <- atomic_logical_formula; <- concept_template_with_links;;
@then_lr_classify_known_doctors_message <- atomic_logical_formula;;

@or_lr_classify_known_doctors_message = { @if_lr_classify_known_doctors_message_1; @if_lr_classify_known_doctors_message_2; @if_lr_classify_known_doctors_message_3 };;
@or_lr_classify_known_doctors_message <- nrel_disjunction;;
@impl_lr_classify_known_doctors_message = (@or_lr_classify_known_doctors_message => @then_lr_classify_known_doctors_message);;
@impl_lr_classify_known_doctors_message <- nrel_implication;;

lr_classify_known_doctors_message
<- concept_classify_message_rule_priority_1;
=> nrel_main_idtf:
	[правило классификации: Какие врачи бывают?] (* <- lang_ru;; *);
-> rrel_main_key_sc_element: @impl_lr_classify_known_doctors_message;;
