concept_message_about_drug_indications
<- sc_node_class;
=> nrel_main_idtf:
	[сообщение о показаниях к применению лекарственного средства] (* <- lang_ru;; *);
	[message about drug indications] (* <- lang_en;; *);
=> nrel_wit_ai_idtf:
	[about_drug_indications];
<= nrel_inclusion:
	concept_message_about_drug;
=> nrel_definition:
	[сообщение о лекарственном средстве, в котором запрашиваются заболевания, при которых применяется указанное лекарственное средство] (* <- lang_ru;; *);
=> nrel_note:
	[пример сообщения: «От чего помогает ибупрофен?»; выделяемые сущности (роль rrel_entity): лекарственное средство] (* <- lang_ru;; *);
<- rrel_key_sc_element:
	...
	(*
		=> nrel_main_idtf:
			[Опр. (сообщение о показаниях к применению лекарственного средства)] (* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
			...
			(*
				-> rrel_example:
					[Сообщение о показаниях к применению лекарственного средства - сообщение о лекарственном средстве, в котором запрашиваются заболевания, при которых применяется указанное лекарственное средство.] (* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
		{
			concept_message_about_drug;
			nrel_indication;
			rrel_entity
		};;
	*);;
