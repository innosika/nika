concept_message_about_drug_side_effects
<- sc_node_class;
=> nrel_main_idtf:
	[сообщение о побочных эффектах лекарственного средства] (* <- lang_ru;; *);
	[message about drug side effects] (* <- lang_en;; *);
=> nrel_wit_ai_idtf:
	[about_drug_side_effects];
<= nrel_inclusion:
	concept_message_about_drug;
=> nrel_definition:
	[сообщение о лекарственном средстве, в котором запрашиваются побочные эффекты указанного лекарственного средства] (* <- lang_ru;; *);
=> nrel_note:
	[пример сообщения: «Какие побочные эффекты у морфина?»; выделяемые сущности (роль rrel_entity): лекарственное средство] (* <- lang_ru;; *);
<- rrel_key_sc_element:
	...
	(*
		=> nrel_main_idtf:
			[Опр. (сообщение о побочных эффектах лекарственного средства)] (* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
			...
			(*
				-> rrel_example:
					[Сообщение о побочных эффектах лекарственного средства - сообщение о лекарственном средстве, в котором запрашиваются побочные эффекты указанного лекарственного средства.] (* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
		{
			concept_message_about_drug;
			nrel_side_effect;
			rrel_entity
		};;
	*);;
