/* Раздел базы знаний «Предметная область медицины».
   Индивидуальный вариант лабораторной работы №1 - «Медицина».
   Тематические ветки: заболевания, клинические проявления (симптомы и синдромы),
   анатомические структуры (органы и системы органов), возбудители заболеваний,
   методы диагностики, методы лечения, лекарственные средства (в том числе вакцины),
   медицинские работники, медицинские учреждения, медицинское оборудование. */

section_subject_domain_of_medicine
=> nrel_main_idtf:
	[Раздел. Предметная область медицины] (* <- lang_ru;; *);
	[Section. Subject domain of medicine] (* <- lang_en;; *);
<- atomic_section;;

/* Структура предметной области: максимальные и немаксимальные классы объектов
   исследования и исследуемые отношения. */
section_subject_domain_of_medicine = [*
	subject_domain_of_medicine
	<- sc_node_structure;
	=> nrel_main_idtf:
		[Предметная область медицины] (* <- lang_ru;; *);
		[Subject domain of medicine] (* <- lang_en;; *);
	<- subject_domain;
	-> rrel_maximum_studied_object_class:
		concept_disease;
		concept_clinical_manifestation;
		concept_anatomical_structure;
		concept_pathogen;
		concept_diagnostic_method;
		concept_treatment_method;
		concept_drug;
		concept_medical_worker;
		concept_medical_institution;
		concept_medical_equipment;
	-> rrel_not_maximum_studied_object_class:
		concept_infectious_disease;
		concept_non_infectious_disease;
		concept_viral_disease;
		concept_bacterial_disease;
		concept_acute_respiratory_viral_infection;
