		concept_diabetes_mellitus;
		concept_symptom;
		concept_syndrome;
		concept_subjective_symptom;
		concept_objective_symptom;
		concept_physical_sign;
		concept_laboratory_instrumental_sign;
		concept_organ_system;
		concept_organ;
		concept_hollow_organ;
		concept_parenchymal_organ;
		concept_gland;
		concept_endocrine_gland;
		concept_exocrine_gland;
		concept_mixed_secretion_gland;
		concept_virus;
		concept_bacterium;
		concept_rna_virus;
		concept_dna_virus;
		concept_gram_positive_bacterium;
		concept_gram_negative_bacterium;
		concept_physical_examination_method;
		concept_instrumental_diagnostic_method;
		concept_laboratory_diagnostic_method;
		concept_imaging_method;
		concept_functional_diagnostic_method;
		concept_radiological_method;
		concept_ultrasound_method;
		concept_conservative_treatment;
		concept_surgical_treatment;
		concept_pharmacotherapy;
		concept_non_drug_therapy;
		concept_etiotropic_therapy;
		concept_pathogenetic_therapy;
		concept_symptomatic_therapy;
