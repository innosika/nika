nrel_syndrome
<- sc_node_non_role_relation;
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
<- antitransitive_relation;
=> nrel_main_idtf:
	[синдром*] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[syndrome*] (* <- lang_en;; *);
=> nrel_first_domain:
	concept_disease;
=> nrel_second_domain:
	concept_syndrome;
=> nrel_definitional_domain:
	...
	(*
		<= nrel_combination:
		{
			concept_disease;
			concept_syndrome
		};;
	*);
=> nrel_definition:
	[бинарное ориентированное отношение, связывающее заболевание с синдромом, характерным для этого заболевания] (* <- lang_ru;; *);
<- rrel_key_sc_element:
	...
	(*
		=> nrel_main_idtf:
			[Опр. (синдром*)] (* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
			...
			(*
				-> rrel_example:
					[Синдром* - бинарное ориентированное отношение, связывающее заболевание с синдромом, характерным для этого заболевания.] (* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
		{
			concept_disease;
			concept_syndrome
		};;
	*);;
