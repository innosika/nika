nrel_component_symptom
<- sc_node_non_role_relation;
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
<- antitransitive_relation;
=> nrel_main_idtf:
	[симптом-компонент*] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[component symptom*] (* <- lang_en;; *);
=> nrel_first_domain:
	concept_syndrome;
=> nrel_second_domain:
	concept_symptom;
=> nrel_definitional_domain:
	...
	(*
		<= nrel_combination:
		{
			concept_syndrome;
			concept_symptom
		};;
	*);
=> nrel_definition:
	[бинарное ориентированное отношение, связывающее синдром с симптомом, входящим в его состав] (* <- lang_ru;; *);
<- rrel_key_sc_element:
	...
	(*
		=> nrel_main_idtf:
			[Опр. (симптом-компонент*)] (* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
			...
			(*
				-> rrel_example:
					[Симптом-компонент* - бинарное ориентированное отношение, связывающее синдром с симптомом, входящим в его состав.] (* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
		{
			concept_syndrome;
			concept_symptom
		};;
	*);;
