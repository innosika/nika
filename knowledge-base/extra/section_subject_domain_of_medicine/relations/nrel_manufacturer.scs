nrel_manufacturer
<- sc_node_non_role_relation;
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
<- antitransitive_relation;
=> nrel_main_idtf:
	[производитель*] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[manufacturer*] (* <- lang_en;; *);
=> nrel_first_domain:
	concept_drug;
=> nrel_second_domain:
	file;
=> nrel_definitional_domain:
	...
	(*
		<= nrel_combination:
		{
			concept_drug;
			file
		};;
	*);
=> nrel_definition:
	[бинарное ориентированное отношение, связывающее лекарственное средство с наименованием организации, которая его производит] (* <- lang_ru;; *);
<- rrel_key_sc_element:
	...
	(*
		=> nrel_main_idtf:
			[Опр. (производитель*)] (* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
			...
			(*
				-> rrel_example:
					[Производитель* - бинарное ориентированное отношение, связывающее лекарственное средство с наименованием организации, которая его производит.] (* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
		{
			concept_drug;
			file
		};;
	*);;
