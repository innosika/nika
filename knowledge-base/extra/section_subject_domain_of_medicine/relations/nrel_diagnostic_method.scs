nrel_diagnostic_method
<- sc_node_non_role_relation;
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
<- antitransitive_relation;
=> nrel_main_idtf:
	[метод диагностики*] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[diagnostic method*] (* <- lang_en;; *);
=> nrel_first_domain:
	concept_disease;
=> nrel_second_domain:
	concept_diagnostic_method;
=> nrel_definitional_domain:
	...
	(*
		<= nrel_combination:
		{
			concept_disease;
			concept_diagnostic_method
		};;
	*);
=> nrel_definition:
	[бинарное ориентированное отношение, связывающее заболевание с методом, применяемым для его выявления] (* <- lang_ru;; *);
<- rrel_key_sc_element:
	...
	(*
		=> nrel_main_idtf:
			[Опр. (метод диагностики*)] (* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
			...
			(*
				-> rrel_example:
					[Метод диагностики* - бинарное ориентированное отношение, связывающее заболевание с методом, применяемым для его выявления.] (* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
		{
			concept_disease;
			concept_diagnostic_method
		};;
	*);;
