nrel_examined_organ
<- sc_node_non_role_relation;
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
<- antitransitive_relation;
=> nrel_main_idtf:
	[исследуемый орган*] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[examined organ*] (* <- lang_en;; *);
=> nrel_first_domain:
	concept_diagnostic_method;
=> nrel_second_domain:
	concept_organ;
=> nrel_definitional_domain:
	...
	(*
		<= nrel_combination:
		{
			concept_diagnostic_method;
			concept_organ
		};;
	*);
=> nrel_definition:
	[бинарное ориентированное отношение, связывающее метод диагностики с органом, состояние которого этим методом оценивается] (* <- lang_ru;; *);
<- rrel_key_sc_element:
	...
	(*
		=> nrel_main_idtf:
			[Опр. (исследуемый орган*)] (* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
			...
			(*
				-> rrel_example:
					[Исследуемый орган* - бинарное ориентированное отношение, связывающее метод диагностики с органом, состояние которого этим методом оценивается.] (* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
		{
			concept_diagnostic_method;
			concept_organ
		};;
	*);;
