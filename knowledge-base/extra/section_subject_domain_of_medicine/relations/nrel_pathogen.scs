nrel_pathogen
<- sc_node_non_role_relation;
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
<- antitransitive_relation;
=> nrel_main_idtf:
	[возбудитель*] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[pathogen*] (* <- lang_en;; *);
=> nrel_first_domain:
	concept_infectious_disease;
=> nrel_second_domain:
	concept_pathogen;
=> nrel_definitional_domain:
	...
	(*
		<= nrel_combination:
		{
			concept_infectious_disease;
			concept_pathogen
		};;
	*);
=> nrel_definition:
	[бинарное ориентированное отношение, связывающее инфекционное заболевание с микроорганизмом, который его вызывает] (* <- lang_ru;; *);
<- rrel_key_sc_element:
	...
	(*
		=> nrel_main_idtf:
			[Опр. (возбудитель*)] (* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
			...
			(*
				-> rrel_example:
					[Возбудитель* - бинарное ориентированное отношение, связывающее инфекционное заболевание с микроорганизмом, который его вызывает.] (* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
		{
			concept_infectious_disease;
			concept_pathogen
		};;
	*);;
