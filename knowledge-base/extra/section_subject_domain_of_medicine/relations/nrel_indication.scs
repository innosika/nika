nrel_indication
<- sc_node_non_role_relation;
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
<- antitransitive_relation;
=> nrel_main_idtf:
	[показание к применению*] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[indication*] (* <- lang_en;; *);
=> nrel_first_domain:
	concept_drug;
=> nrel_second_domain:
	concept_disease;
=> nrel_definitional_domain:
	...
	(*
		<= nrel_combination:
		{
			concept_drug;
			concept_disease
		};;
	*);
=> nrel_definition:
	[бинарное ориентированное отношение, связывающее лекарственное средство с заболеванием, при котором оно назначается] (* <- lang_ru;; *);
<- rrel_key_sc_element:
	...
	(*
		=> nrel_main_idtf:
			[Опр. (показание к применению*)] (* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
			...
			(*
				-> rrel_example:
					[Показание к применению* - бинарное ориентированное отношение, связывающее лекарственное средство с заболеванием, при котором оно назначается.] (* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
		{
			concept_drug;
			concept_disease
		};;
	*);;
