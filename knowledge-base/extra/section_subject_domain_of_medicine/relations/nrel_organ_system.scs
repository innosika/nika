nrel_organ_system
<- sc_node_non_role_relation;
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
<- antitransitive_relation;
=> nrel_main_idtf:
	[входит в систему органов*] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[belongs to organ system*] (* <- lang_en;; *);
=> nrel_first_domain:
	concept_organ;
=> nrel_second_domain:
	concept_organ_system;
=> nrel_definitional_domain:
	...
	(*
		<= nrel_combination:
		{
			concept_organ;
			concept_organ_system
		};;
	*);
=> nrel_definition:
	[бинарное ориентированное отношение, связывающее орган с системой органов, в состав которой он входит] (* <- lang_ru;; *);
<- rrel_key_sc_element:
	...
	(*
		=> nrel_main_idtf:
			[Опр. (входит в систему органов*)] (* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
			...
			(*
				-> rrel_example:
					[Входит в систему органов* - бинарное ориентированное отношение, связывающее орган с системой органов, в состав которой он входит.] (* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
		{
			concept_organ;
			concept_organ_system
		};;
	*);;
