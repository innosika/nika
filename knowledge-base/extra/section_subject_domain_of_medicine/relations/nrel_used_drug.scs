nrel_used_drug
<- sc_node_non_role_relation;
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
<- antitransitive_relation;
=> nrel_main_idtf:
	[применяемое лекарственное средство*] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[used drug*] (* <- lang_en;; *);
=> nrel_first_domain:
	concept_pharmacotherapy;
=> nrel_second_domain:
	concept_drug;
=> nrel_definitional_domain:
	...
	(*
		<= nrel_combination:
		{
			concept_pharmacotherapy;
			concept_drug
		};;
	*);
=> nrel_definition:
	[бинарное ориентированное отношение, связывающее вид медикаментозной терапии с лекарственным средством, которое при ней применяется] (* <- lang_ru;; *);
<- rrel_key_sc_element:
	...
	(*
		=> nrel_main_idtf:
			[Опр. (применяемое лекарственное средство*)] (* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
			...
			(*
				-> rrel_example:
					[Применяемое лекарственное средство* - бинарное ориентированное отношение, связывающее вид медикаментозной терапии с лекарственным средством, которое при ней применяется.] (* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
		{
			concept_pharmacotherapy;
			concept_drug
		};;
	*);;
