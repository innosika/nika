nrel_specialist
<- sc_node_non_role_relation;
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
<- antitransitive_relation;
=> nrel_main_idtf:
	[профильный врач*] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[attending specialist*] (* <- lang_en;; *);
=> nrel_first_domain:
	concept_disease;
=> nrel_second_domain:
	concept_physician;
=> nrel_definitional_domain:
	...
	(*
		<= nrel_combination:
		{
			concept_disease;
			concept_physician
		};;
	*);
=> nrel_definition:
	[бинарное ориентированное отношение, связывающее заболевание с врачом той специальности, которая занимается его диагностикой и лечением] (* <- lang_ru;; *);
<- rrel_key_sc_element:
	...
	(*
		=> nrel_main_idtf:
			[Опр. (профильный врач*)] (* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
			...
			(*
				-> rrel_example:
					[Профильный врач* - бинарное ориентированное отношение, связывающее заболевание с врачом той специальности, которая занимается его диагностикой и лечением.] (* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
		{
			concept_disease;
			concept_physician
		};;
	*);;
