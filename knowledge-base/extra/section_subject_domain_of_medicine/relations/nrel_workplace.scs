nrel_workplace
<- sc_node_non_role_relation;
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
<- antitransitive_relation;
=> nrel_main_idtf:
	[место работы*] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[workplace*] (* <- lang_en;; *);
=> nrel_first_domain:
	concept_medical_worker;
=> nrel_second_domain:
	concept_medical_institution;
=> nrel_definitional_domain:
	...
	(*
		<= nrel_combination:
		{
			concept_medical_worker;
			concept_medical_institution
		};;
	*);
=> nrel_definition:
	[бинарное ориентированное отношение, связывающее медицинского работника с медицинским учреждением, в котором он работает] (* <- lang_ru;; *);
<- rrel_key_sc_element:
	...
	(*
		=> nrel_main_idtf:
			[Опр. (место работы*)] (* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
			...
			(*
				-> rrel_example:
					[Место работы* - бинарное ориентированное отношение, связывающее медицинского работника с медицинским учреждением, в котором он работает.] (* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
		{
			concept_medical_worker;
			concept_medical_institution
		};;
	*);;
