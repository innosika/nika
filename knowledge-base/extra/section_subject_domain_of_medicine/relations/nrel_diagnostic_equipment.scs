nrel_diagnostic_equipment
<- sc_node_non_role_relation;
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
<- antitransitive_relation;
=> nrel_main_idtf:
	[используемое диагностическое оборудование*] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[used diagnostic equipment*] (* <- lang_en;; *);
=> nrel_first_domain:
	concept_diagnostic_method;
=> nrel_second_domain:
	concept_medical_equipment;
=> nrel_definitional_domain:
	...
	(*
		<= nrel_combination:
		{
			concept_diagnostic_method;
			concept_medical_equipment
		};;
	*);
=> nrel_definition:
	[бинарное ориентированное отношение, связывающее метод диагностики с медицинским оборудованием, с помощью которого он выполняется] (* <- lang_ru;; *);
<- rrel_key_sc_element:
	...
	(*
		=> nrel_main_idtf:
			[Опр. (используемое диагностическое оборудование*)] (* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
			...
			(*
				-> rrel_example:
					[Используемое диагностическое оборудование* - бинарное ориентированное отношение, связывающее метод диагностики с медицинским оборудованием, с помощью которого он выполняется.] (* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
		{
			concept_diagnostic_method;
			concept_medical_equipment
		};;
	*);;
