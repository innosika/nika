nrel_symptom
<- sc_node_non_role_relation;
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
<- antitransitive_relation;
=> nrel_main_idtf:
	[симптом*] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[symptom*] (* <- lang_en;; *);
=> nrel_first_domain:
	concept_disease;
=> nrel_second_domain:
	concept_symptom;
=> nrel_definitional_domain:
	...
	(*
		<= nrel_combination:
		{
			concept_disease;
			concept_symptom
		};;
	*);
=> nrel_definition:
	[бинарное ориентированное отношение, связывающее заболевание с симптомом, который наблюдается при этом заболевании] (* <- lang_ru;; *);
=> nrel_note:
	[один симптом может встречаться при многих заболеваниях, поэтому отношение не является функциональным] (* <- lang_ru;; *);
<- rrel_key_sc_element:
	...
	(*
		=> nrel_main_idtf:
			[Опр. (симптом*)] (* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
			...
			(*
				-> rrel_example:
					[Симптом* - бинарное ориентированное отношение, связывающее заболевание с симптомом, который наблюдается при этом заболевании.] (* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
		{
			concept_disease;
			concept_symptom
		};;
	*);;
