nrel_function
<- sc_node_non_role_relation;
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
<- antitransitive_relation;
=> nrel_main_idtf:
	[функция*] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[function*] (* <- lang_en;; *);
=> nrel_first_domain:
	concept_organ;
=> nrel_second_domain:
	file;
=> nrel_definitional_domain:
	...
	(*
		<= nrel_combination:
		{
			concept_organ;
			file
		};;
	*);
=> nrel_definition:
	[бинарное ориентированное отношение, связывающее орган с описанием его основной физиологической функции] (* <- lang_ru;; *);
<- rrel_key_sc_element:
	...
	(*
		=> nrel_main_idtf:
			[Опр. (функция*)] (* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
			...
			(*
				-> rrel_example:
					[Функция* - бинарное ориентированное отношение, связывающее орган с описанием его основной физиологической функции.] (* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
		{
			concept_organ;
			file
		};;
	*);;
