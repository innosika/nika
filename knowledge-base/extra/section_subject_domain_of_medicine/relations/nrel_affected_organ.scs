nrel_affected_organ
<- sc_node_non_role_relation;
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
<- antitransitive_relation;
=> nrel_main_idtf:
	[поражаемый орган*] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[affected organ*] (* <- lang_en;; *);
=> nrel_first_domain:
	concept_disease;
=> nrel_second_domain:
	concept_organ;
=> nrel_definitional_domain:
	...
	(*
		<= nrel_combination:
		{
			concept_disease;
			concept_organ
		};;
	*);
=> nrel_definition:
	[бинарное ориентированное отношение, связывающее заболевание с органом, который преимущественно поражается при этом заболевании] (* <- lang_ru;; *);
<- rrel_key_sc_element:
	...
	(*
		=> nrel_main_idtf:
			[Опр. (поражаемый орган*)] (* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
			...
			(*
				-> rrel_example:
					[Поражаемый орган* - бинарное ориентированное отношение, связывающее заболевание с органом, который преимущественно поражается при этом заболевании.] (* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
		{
			concept_disease;
			concept_organ
		};;
	*);;
