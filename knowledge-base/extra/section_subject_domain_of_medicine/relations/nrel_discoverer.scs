nrel_discoverer
<- sc_node_non_role_relation;
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
<- antitransitive_relation;
=> nrel_main_idtf:
	[первооткрыватель*] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[discoverer*] (* <- lang_en;; *);
=> nrel_first_domain:
	concept_pathogen;
=> nrel_second_domain:
	file;
=> nrel_definitional_domain:
	...
	(*
		<= nrel_combination:
		{
			concept_pathogen;
			file
		};;
	*);
=> nrel_definition:
	[бинарное ориентированное отношение, связывающее возбудителя заболевания с сведениями о том, кем и когда он был открыт] (* <- lang_ru;; *);
<- rrel_key_sc_element:
	...
	(*
		=> nrel_main_idtf:
			[Опр. (первооткрыватель*)] (* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
			...
			(*
				-> rrel_example:
					[Первооткрыватель* - бинарное ориентированное отношение, связывающее возбудителя заболевания с сведениями о том, кем и когда он был открыт.] (* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
		{
			concept_pathogen;
			file
		};;
	*);;
