nrel_treatment_method
<- sc_node_non_role_relation;
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
<- antitransitive_relation;
=> nrel_main_idtf:
	[метод лечения*] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[treatment method*] (* <- lang_en;; *);
=> nrel_first_domain:
	concept_disease;
=> nrel_second_domain:
	concept_treatment_method;
=> nrel_definitional_domain:
	...
	(*
		<= nrel_combination:
		{
			concept_disease;
			concept_treatment_method
		};;
	*);
=> nrel_definition:
	[бинарное ориентированное отношение, связывающее заболевание с методом, применяемым для его лечения] (* <- lang_ru;; *);
<- rrel_key_sc_element:
	...
	(*
		=> nrel_main_idtf:
			[Опр. (метод лечения*)] (* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
			...
			(*
				-> rrel_example:
					[Метод лечения* - бинарное ориентированное отношение, связывающее заболевание с методом, применяемым для его лечения.] (* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
		{
			concept_disease;
			concept_treatment_method
		};;
	*);;
