nrel_icd_code
<- sc_node_non_role_relation;
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
<- antitransitive_relation;
=> nrel_main_idtf:
	[код МКБ-10*] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[ICD-10 code*] (* <- lang_en;; *);
=> nrel_first_domain:
	concept_disease;
=> nrel_second_domain:
	file;
=> nrel_definitional_domain:
	...
	(*
		<= nrel_combination:
		{
			concept_disease;
			file
		};;
	*);
=> nrel_definition:
	[бинарное ориентированное отношение, связывающее заболевание с его кодом в Международной классификации болезней 10-го пересмотра] (* <- lang_ru;; *);
<- rrel_key_sc_element:
	...
	(*
		=> nrel_main_idtf:
			[Опр. (код МКБ-10*)] (* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
			...
			(*
				-> rrel_example:
					[Код МКБ-10* - бинарное ориентированное отношение, связывающее заболевание с его кодом в Международной классификации болезней 10-го пересмотра.] (* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
		{
			concept_disease;
			file
		};;
	*);;
