concept_antiviral_drug
<- sc_node_class;
<- concept_wit_entity;
=> nrel_main_idtf:
	[противовирусное средство] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[antiviral drug] (* <- lang_en;; *);
=> nrel_idtf:
	[противовирусный препарат] (* <- lang_ru;; *);
<= nrel_inclusion:
	concept_antimicrobial_drug;
=> nrel_definition:
	[противомикробное средство, подавляющее размножение вирусов в клетках организма] (* <- lang_ru;; *);
=> nrel_note:
	[большинство противовирусных средств действуют на определённые ферменты вируса - нейраминидазу, полимеразу, протеазу] (* <- lang_ru;; *);;
