concept_rna_virus
<- sc_node_class;
<- concept_wit_entity;
=> nrel_main_idtf:
	[РНК-содержащий вирус] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[RNA virus] (* <- lang_en;; *);
=> nrel_idtf:
	[РНК-вирус] (* <- lang_ru;; *);
<= nrel_inclusion:
	concept_virus;
=> nrel_definition:
	[вирус, геном которого представлен рибонуклеиновой кислотой] (* <- lang_ru;; *);
=> nrel_note:
	[РНК-вирусы отличаются высокой скоростью мутаций, что затрудняет создание устойчивого иммунитета и вакцин] (* <- lang_ru;; *);;
