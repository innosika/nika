concept_mixed_secretion_gland
<- sc_node_class;
<- concept_wit_entity;
=> nrel_main_idtf:
	[железа смешанной секреции] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[mixed secretion gland] (* <- lang_en;; *);
<= nrel_inclusion:
	concept_gland;
=> nrel_definition:
	[железа, имеющая одновременно экзокринную часть с выводными протоками и эндокринную часть, выделяющую гормоны в кровь] (* <- lang_ru;; *);
=> nrel_note:
	[к железам смешанной секреции относятся поджелудочная железа и половые железы] (* <- lang_ru;; *);;
