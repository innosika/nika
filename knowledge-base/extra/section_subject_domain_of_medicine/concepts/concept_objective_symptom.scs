concept_objective_symptom
<- sc_node_class;
<- concept_wit_entity;
=> nrel_main_idtf:
	[объективный симптом] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[objective symptom] (* <- lang_en;; *);
<= nrel_inclusion:
	concept_symptom;
=> nrel_inclusion:
	concept_physical_sign;
=> nrel_inclusion:
	concept_laboratory_instrumental_sign;
<= nrel_subdividing:
	...
	(*
		<- sc_node_tuple;;
		=> nrel_main_idtf:
			[разбиение объективных симптомов по способу регистрации] (* <- lang_ru;; *);;
		-> concept_physical_sign;;
		-> concept_laboratory_instrumental_sign;;
	*);
=> nrel_definition:
	[симптом, выявляемый врачом при осмотре пациента или с помощью инструментальных и лабораторных методов] (* <- lang_ru;; *);
=> nrel_note:
	[объективные симптомы в англоязычной литературе называют признаками (signs) в отличие от жалоб (symptoms)] (* <- lang_ru;; *);;
