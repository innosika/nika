concept_diagnostic_method
<- sc_node_class;
<- concept_wit_entity;
=> nrel_main_idtf:
	[метод диагностики] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[diagnostic method] (* <- lang_en;; *);
=> nrel_inclusion:
	concept_physical_examination_method;
=> nrel_inclusion:
	concept_instrumental_diagnostic_method;
=> nrel_inclusion:
	concept_laboratory_diagnostic_method;
<= nrel_subdividing:
	...
	(*
		<- sc_node_tuple;;
		=> nrel_main_idtf:
			[разбиение методов диагностики по используемым средствам] (* <- lang_ru;; *);;
		-> concept_physical_examination_method;;
		-> concept_instrumental_diagnostic_method;;
		-> concept_laboratory_diagnostic_method;;
	*);
=> nrel_definition:
	[способ выявления заболевания и определения его характера на основе изучения признаков, обнаруживаемых у пациента] (* <- lang_ru;; *);
=> nrel_note:
	[диагностика включает сбор анамнеза, физикальное обследование, лабораторные и инструментальные исследования] (* <- lang_ru;; *);;
