concept_surgical_physician
<- sc_node_class;
<- concept_wit_entity;
=> nrel_main_idtf:
	[врач хирургического профиля] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[physician of surgical profile] (* <- lang_en;; *);
