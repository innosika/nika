concept_influenza
<- sc_node_class;
<- concept_wit_entity;
=> nrel_main_idtf:
	[грипп] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[influenza] (* <- lang_en;; *);
<= nrel_inclusion:
	concept_acute_respiratory_viral_infection;
=> nrel_definition:
	[острая респираторная вирусная инфекция, вызываемая вирусами гриппа типов A, B и C и характеризующаяся выраженной интоксикацией, высокой лихорадкой и поражением дыхательных путей<br><img src="data:image/jpeg;base64," width="320" alt="influenza">] (* <- lang_ru;; => nrel_format: format_html;; *);
=> nrel_note:
	[по оценкам ВОЗ, сезонные эпидемии гриппа ежегодно вызывают от 290 до 650 тысяч смертей от респираторных осложнений] (* <- lang_ru;; *);;
