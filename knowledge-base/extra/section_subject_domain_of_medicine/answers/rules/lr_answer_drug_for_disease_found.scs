/* Правило ответа на сообщение о применимости лекарственного средства при заболевании: сведения есть в базе знаний.
   Если: сообщение о применимости лекарственного средства при заболевании, выделены препарат и заболевание, и препарат показан при этом заболевании ИЛИ входит в метод его лечения.
   Автор: Банкевич Я. */

@if_lr_answer_drug_for_disease_found_1 = [*
	_message _-> rrel_entity:: _drug;;
	_message _-> rrel_entity:: _disease;;
	_drug _=> nrel_indication:: _disease;;
	concept_message _-> _message;;
	concept_message_about_drug_for_disease _-> _message;;
*];;
@if_lr_answer_drug_for_disease_found_2 = [*
	_message _-> rrel_entity:: _drug;;
	_message _-> rrel_entity:: _disease;;
	_disease _=> nrel_treatment_method:: _treatment;;
	_treatment _=> nrel_used_drug:: _drug;;
	concept_message _-> _message;;
	concept_message_about_drug_for_disease _-> _message;;
*];;
@or_lr_answer_drug_for_disease_found = { @if_lr_answer_drug_for_disease_found_1; @if_lr_answer_drug_for_disease_found_2 };;
@or_lr_answer_drug_for_disease_found <- nrel_disjunction;;
@then_lr_answer_drug_for_disease_found = [*
	_message _=> nrel_reply:: _reply_message;;
	concept_atomic_message _-> _reply_message;;
	concept_message_about_drug_for_disease _-> _reply_message;;
*];;
@if_lr_answer_drug_for_disease_found_1 <- atomic_logical_formula;;
@if_lr_answer_drug_for_disease_found_2 <- atomic_logical_formula;;
@then_lr_answer_drug_for_disease_found <- atomic_logical_formula;;
@impl_lr_answer_drug_for_disease_found = (@or_lr_answer_drug_for_disease_found => @then_lr_answer_drug_for_disease_found);;
@impl_lr_answer_drug_for_disease_found <- nrel_implication;;
answer_pattern_lr_answer_drug_for_disease_found
<- sc_node_tuple;
-> rrel_1: concept_phrase_about_drug_for_disease_found;;
lr_answer_drug_for_disease_found
<- concept_answer_on_standard_message_rule;
<- concept_answer_on_standard_message_rule_priority_2;
=> nrel_main_idtf:
	[правило ответа на сообщение о применимости лекарственного средства при заболевании: сведения есть в базе знаний] (* <- lang_ru;; *);
	[rule of reply to a message about applicability of a drug for a disease: the data is in the knowledge base] (* <- lang_en;; *);
=> nrel_note:
	[если сообщение о применимости лекарственного средства при заболевании, выделены препарат и заболевание, и препарат показан при этом заболевании ИЛИ входит в метод его лечения; фразы ответа — из класса concept_phrase_about_drug_for_disease_found] (* <- lang_ru;; *);
=> nrel_answer_pattern: answer_pattern_lr_answer_drug_for_disease_found;
-> rrel_main_key_sc_element: @impl_lr_answer_drug_for_disease_found;;
