/* Правило ответа на сообщение о применимости лекарственного средства при заболевании: вопрос о группе.
   Если: выделены группа лекарственных средств и заболевание, и хотя бы один препарат группы показан при этом заболевании ИЛИ входит в метод его лечения.
   Автор: Банкевич Я. */

@if_lr_answer_drug_for_disease_for_group_1 = [*
	_message _-> rrel_entity:: _drug;;
	_message _-> rrel_entity:: _disease;;
	_drug _-> _drug_instance;;
	_drug_instance _=> nrel_indication:: _disease;;
	concept_message _-> _message;;
	concept_message_about_drug_for_disease _-> _message;;
*];;
@if_lr_answer_drug_for_disease_for_group_2 = [*
	_message _-> rrel_entity:: _drug;;
	_message _-> rrel_entity:: _disease;;
	_drug _-> _drug_instance;;
	_disease _=> nrel_treatment_method:: _treatment;;
	_treatment _=> nrel_used_drug:: _drug_instance;;
	concept_message _-> _message;;
	concept_message_about_drug_for_disease _-> _message;;
*];;
@or_lr_answer_drug_for_disease_for_group = { @if_lr_answer_drug_for_disease_for_group_1; @if_lr_answer_drug_for_disease_for_group_2 };;
@or_lr_answer_drug_for_disease_for_group <- nrel_disjunction;;
@then_lr_answer_drug_for_disease_for_group = [*
	_message _=> nrel_reply:: _reply_message;;
	concept_atomic_message _-> _reply_message;;
	concept_message_about_drug_for_disease _-> _reply_message;;
*];;
@if_lr_answer_drug_for_disease_for_group_1 <- atomic_logical_formula;;
@if_lr_answer_drug_for_disease_for_group_2 <- atomic_logical_formula;;
@then_lr_answer_drug_for_disease_for_group <- atomic_logical_formula;;
@impl_lr_answer_drug_for_disease_for_group = (@or_lr_answer_drug_for_disease_for_group => @then_lr_answer_drug_for_disease_for_group);;
@impl_lr_answer_drug_for_disease_for_group <- nrel_implication;;
answer_pattern_lr_answer_drug_for_disease_for_group
<- sc_node_tuple;
-> rrel_1: concept_phrase_about_drug_for_disease_for_group;;
lr_answer_drug_for_disease_for_group
<- concept_answer_on_standard_message_rule;
<- concept_answer_on_standard_message_rule_priority_2;
=> nrel_main_idtf:
	[правило ответа на сообщение о применимости лекарственного средства при заболевании: вопрос о группе] (* <- lang_ru;; *);
	[rule of reply to a message about applicability of a drug for a disease: question about a group] (* <- lang_en;; *);
=> nrel_note:
	[если выделены группа лекарственных средств и заболевание, и хотя бы один препарат группы показан при этом заболевании ИЛИ входит в метод его лечения; фразы ответа — из класса concept_phrase_about_drug_for_disease_for_group] (* <- lang_ru;; *);
=> nrel_answer_pattern: answer_pattern_lr_answer_drug_for_disease_for_group;
-> rrel_main_key_sc_element: @impl_lr_answer_drug_for_disease_for_group;;
