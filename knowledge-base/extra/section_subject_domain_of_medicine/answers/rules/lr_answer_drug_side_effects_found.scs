/* Правило ответа на сообщение о побочных эффектах лекарственного средства: сведения есть в базе знаний.
   Если: сообщение о побочных эффектах лекарственного средства, выделена сущность, и в базе знаний есть связь «побочный эффект*».
   Автор: Банкевич Я. */

@if_lr_answer_drug_side_effects_found = [*
	concept_message _-> _message;;
	concept_message_about_drug_side_effects _-> _message;;
	_message _-> rrel_entity:: _entity;;
	_entity _=> nrel_side_effect:: _side_effect;;
*];;
@then_lr_answer_drug_side_effects_found = [*
	_message _=> nrel_reply:: _reply_message;;
	concept_atomic_message _-> _reply_message;;
	concept_message_about_drug_side_effects _-> _reply_message;;
*];;
@if_lr_answer_drug_side_effects_found <- atomic_logical_formula;;
@then_lr_answer_drug_side_effects_found <- atomic_logical_formula;;
@impl_lr_answer_drug_side_effects_found = (@if_lr_answer_drug_side_effects_found => @then_lr_answer_drug_side_effects_found);;
@impl_lr_answer_drug_side_effects_found <- nrel_implication;;
answer_pattern_lr_answer_drug_side_effects_found
<- sc_node_tuple;
-> rrel_1: concept_phrase_about_drug_side_effects_found;;
lr_answer_drug_side_effects_found
<- concept_answer_on_standard_message_rule;
<- concept_answer_on_standard_message_rule_priority_2;
=> nrel_main_idtf:
	[правило ответа на сообщение о побочных эффектах лекарственного средства: сведения есть в базе знаний] (* <- lang_ru;; *);
	[rule of reply to a message about side effects of a drug: the data is in the knowledge base] (* <- lang_en;; *);
=> nrel_note:
	[если сообщение о побочных эффектах лекарственного средства, выделена сущность, и в базе знаний есть связь «побочный эффект*»; фразы ответа — из класса concept_phrase_about_drug_side_effects_found] (* <- lang_ru;; *);
=> nrel_answer_pattern: answer_pattern_lr_answer_drug_side_effects_found;
-> rrel_main_key_sc_element: @impl_lr_answer_drug_side_effects_found;;
