/* Правило ответа на сообщение о применимости лекарственного средства при заболевании: сведений нет в базе знаний.
   Если: выделены лекарственное средство (экземпляр или группа) и заболевание с известными методами лечения, но правило «да» не сработало (сведений о применимости нет).
   Автор: Банкевич Я. */

@if_lr_answer_drug_for_disease_not_found_1 = [*
	_message _-> rrel_entity:: _drug;;
	_message _-> rrel_entity:: _disease;;
	_drug _=> nrel_indication:: _drug_indication;;
	_disease _=> nrel_treatment_method:: _treatment;;
	concept_message _-> _message;;
	concept_message_about_drug_for_disease _-> _message;;
*];;
@if_lr_answer_drug_for_disease_not_found_2 = [*
	_message _-> rrel_entity:: _drug;;
	_message _-> rrel_entity:: _disease;;
	_drug _-> _drug_instance;;
	_drug_instance _=> nrel_indication:: _drug_indication;;
	_disease _=> nrel_treatment_method:: _treatment;;
	concept_message _-> _message;;
	concept_message_about_drug_for_disease _-> _message;;
*];;
@or_lr_answer_drug_for_disease_not_found = { @if_lr_answer_drug_for_disease_not_found_1; @if_lr_answer_drug_for_disease_not_found_2 };;
@or_lr_answer_drug_for_disease_not_found <- nrel_disjunction;;
@then_lr_answer_drug_for_disease_not_found = [*
	_message _=> nrel_reply:: _reply_message;;
	concept_atomic_message _-> _reply_message;;
	concept_message_about_drug_for_disease _-> _reply_message;;
*];;
@if_lr_answer_drug_for_disease_not_found_1 <- atomic_logical_formula;;
@if_lr_answer_drug_for_disease_not_found_2 <- atomic_logical_formula;;
@then_lr_answer_drug_for_disease_not_found <- atomic_logical_formula;;
@impl_lr_answer_drug_for_disease_not_found = (@or_lr_answer_drug_for_disease_not_found => @then_lr_answer_drug_for_disease_not_found);;
@impl_lr_answer_drug_for_disease_not_found <- nrel_implication;;
answer_pattern_lr_answer_drug_for_disease_not_found
<- sc_node_tuple;
-> rrel_1: concept_phrase_about_drug_for_disease_not_found;;
lr_answer_drug_for_disease_not_found
<- concept_answer_on_standard_message_rule;
<- concept_answer_on_standard_message_rule_priority_3;
=> nrel_main_idtf:
	[правило ответа на сообщение о применимости лекарственного средства при заболевании: сведений нет в базе знаний] (* <- lang_ru;; *);
	[rule of reply to a message about applicability of a drug for a disease: no data in the knowledge base] (* <- lang_en;; *);
=> nrel_note:
	[если выделены лекарственное средство (экземпляр или группа) и заболевание с известными методами лечения, но правило «да» не сработало (сведений о применимости нет); фразы ответа — из класса concept_phrase_about_drug_for_disease_not_found] (* <- lang_ru;; *);
=> nrel_answer_pattern: answer_pattern_lr_answer_drug_for_disease_not_found;
-> rrel_main_key_sc_element: @impl_lr_answer_drug_for_disease_not_found;;
