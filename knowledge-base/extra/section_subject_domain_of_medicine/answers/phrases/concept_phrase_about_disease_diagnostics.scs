	[phrase about diagnostics of a disease: no data] (* <- lang_en;; *);
<= nrel_inclusion:
	concept_phrase_about_disease_diagnostics;
=> nrel_definition:
	[фраза на случай, когда сведений в базе знаний нет] (* <- lang_ru;; *);;

@template_disease_diagnostics_not_found_1 = [*
	concept_message _-> _message;;
	_message _-> rrel_entity:: _entity;;
	_entity _=> nrel_main_idtf:: _entity_name;;
	lang_ru _-> _entity_name;;
*];;
@phrase_disease_diagnostics_not_found_1 = [Методы диагностики для «${_entity_name}» в базе знаний не указаны.];;
@phrase_disease_diagnostics_not_found_1
<- lang_ru;
<- concept_phrase_about_disease_diagnostics_not_found;
=> nrel_phrase_template: @template_disease_diagnostics_not_found_1;;

@template_disease_diagnostics_not_found_2 = [*
	concept_message _-> _message;;
	_message _-> rrel_entity:: _entity;;
	_entity _=> nrel_main_idtf:: _entity_name;;
	lang_ru _-> _entity_name;;
*];;
@phrase_disease_diagnostics_not_found_2 = [Не знаю, как диагностируют «${_entity_name}»: сведений об этом в базе знаний нет.];;
@phrase_disease_diagnostics_not_found_2
<- lang_ru;
<- concept_phrase_about_disease_diagnostics_not_found;
=> nrel_phrase_template: @template_disease_diagnostics_not_found_2;;
