*];;
@phrase_disease_pathogen_non_infectious_2 = [Заболевание «${_entity_name}» относится к неинфекционным — его причина не вирусы и не бактерии, а наследственность, образ жизни и факторы окружающей среды.];;
@phrase_disease_pathogen_non_infectious_2
<- lang_ru;
<- concept_phrase_about_disease_pathogen_non_infectious;
=> nrel_phrase_template: @template_disease_pathogen_non_infectious_2;;

