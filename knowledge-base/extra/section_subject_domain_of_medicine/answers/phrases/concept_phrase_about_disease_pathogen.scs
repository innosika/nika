@phrase_disease_pathogen_non_infectious_1
<- lang_ru;
<- concept_phrase_about_disease_pathogen_non_infectious;
=> nrel_phrase_template: @template_disease_pathogen_non_infectious_1;;

@template_disease_pathogen_non_infectious_2 = [*
	concept_message _-> _message;;
	_message _-> rrel_entity:: _entity;;
	_entity _=> nrel_main_idtf:: _entity_name;;
