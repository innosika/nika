	[phrase about symptoms of a disease: no data] (* <- lang_en;; *);
<= nrel_inclusion:
	concept_phrase_about_disease_symptoms;
=> nrel_definition:
	[фраза на случай, когда сведений в базе знаний нет] (* <- lang_ru;; *);;

@template_disease_symptoms_not_found_1 = [*
	concept_message _-> _message;;
	_message _-> rrel_entity:: _entity;;
	_entity _=> nrel_main_idtf:: _entity_name;;
	lang_ru _-> _entity_name;;
*];;
@phrase_disease_symptoms_not_found_1 = [В моей базе знаний нет сведений о симптомах для «${_entity_name}».];;
@phrase_disease_symptoms_not_found_1
<- lang_ru;
<- concept_phrase_about_disease_symptoms_not_found;
=> nrel_phrase_template: @template_disease_symptoms_not_found_1;;

@template_disease_symptoms_not_found_2 = [*
	concept_message _-> _message;;
	_message _-> rrel_entity:: _entity;;
	_entity _=> nrel_main_idtf:: _entity_name;;
	lang_ru _-> _entity_name;;
*];;
@phrase_disease_symptoms_not_found_2 = [Не могу назвать симптомы для «${_entity_name}»: таких данных в базе знаний нет. Возможно, это не заболевание?];;
@phrase_disease_symptoms_not_found_2
<- lang_ru;
<- concept_phrase_about_disease_symptoms_not_found;
