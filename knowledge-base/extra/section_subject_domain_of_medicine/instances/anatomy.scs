/* Экземпляры понятий: anatomy */

respiratory_system
<- concept_organ_system;
<- concept_wit_entity;
=> nrel_main_idtf:
	[дыхательная система] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[respiratory system] (* <- lang_en;; *);
=> nrel_definition:
	[система органов, обеспечивающая газообмен между организмом и внешней средой и включающая полость носа, гортань, трахею, бронхи и лёгкие] (* <- lang_ru;; *);;

cardiovascular_system
<- concept_organ_system;
<- concept_wit_entity;
=> nrel_main_idtf:
	[сердечно-сосудистая система] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[cardiovascular system] (* <- lang_en;; *);
=> nrel_idtf:
	[система кровообращения] (* <- lang_ru;; *);
=> nrel_definition:
	[система органов, обеспечивающая циркуляцию крови и включающая сердце и кровеносные сосуды] (* <- lang_ru;; *);;

digestive_system
<- concept_organ_system;
<- concept_wit_entity;
=> nrel_main_idtf:
	[пищеварительная система] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[digestive system] (* <- lang_en;; *);
=> nrel_definition:
	[система органов, обеспечивающая механическую и химическую переработку пищи, всасывание питательных веществ и выведение непереваренных остатков] (* <- lang_ru;; *);;

endocrine_system
<- concept_organ_system;
<- concept_wit_entity;
=> nrel_main_idtf:
	[эндокринная система] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[endocrine system] (* <- lang_en;; *);
=> nrel_definition:
	[система желёз внутренней секреции, регулирующая деятельность организма с помощью гормонов] (* <- lang_ru;; *);;

heart
<- concept_hollow_organ;
<- concept_wit_entity;
=> nrel_main_idtf:
	[сердце] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[heart] (* <- lang_en;; *);
=> nrel_definition:
	[полый мышечный орган, обеспечивающий движение крови по сосудам за счёт ритмичных сокращений<br><img src="data:image/jpeg;base64," width="320" alt="heart">] (* <- lang_ru;; => nrel_format: format_html;; *);
=> nrel_note:
	[у взрослого человека в покое сердце сокращается 60-80 раз в минуту и перекачивает около 5 литров крови в минуту] (* <- lang_ru;; *);
=> nrel_organ_system:
	cardiovascular_system;
=> nrel_function:
	[перекачивание крови по большому и малому кругам кровообращения] (* <- lang_ru;; *);;

stomach
<- concept_hollow_organ;
<- concept_wit_entity;
=> nrel_main_idtf:
	[желудок] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[stomach] (* <- lang_en;; *);
=> nrel_definition:
	[полый орган пищеварительной системы, в котором пища накапливается и подвергается химической обработке желудочным соком<br><img src="data:image/jpeg;base64," width="320" alt="stomach">] (* <- lang_ru;; => nrel_format: format_html;; *);
=> nrel_note:
	[объём желудка взрослого человека составляет в среднем 1,5-2 литра] (* <- lang_ru;; *);
=> nrel_organ_system:
	digestive_system;
=> nrel_function:
	[механическая и химическая обработка пищи, выработка соляной кислоты и пепсина] (* <- lang_ru;; *);;

lung
<- concept_parenchymal_organ;
<- concept_wit_entity;
=> nrel_main_idtf:
	[лёгкое] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[lung] (* <- lang_en;; *);
=> nrel_idtf:
	[лёгкие] (* <- lang_ru;; *);
=> nrel_idtf:
	[легкие] (* <- lang_ru;; *);
=> nrel_definition:
	[парный паренхиматозный орган дыхательной системы, в котором происходит газообмен между воздухом и кровью<br><img src="data:image/jpeg;base64," width="320" alt="lung">] (* <- lang_ru;; => nrel_format: format_html;; *);
=> nrel_note:
	[правое лёгкое состоит из трёх долей, левое - из двух] (* <- lang_ru;; *);
=> nrel_organ_system:
	respiratory_system;
=> nrel_function:
	[газообмен - насыщение крови кислородом и удаление углекислого газа] (* <- lang_ru;; *);;

thyroid_gland
<- concept_endocrine_gland;
<- concept_wit_entity;
=> nrel_main_idtf:
	[щитовидная железа] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[thyroid gland] (* <- lang_en;; *);
=> nrel_definition:
	[эндокринная железа, расположенная на передней поверхности шеи и вырабатывающая гормоны тироксин и трийодтиронин, регулирующие обмен веществ<br><img src="data:image/jpeg;base64," width="320" alt="thyroid_gland">] (* <- lang_ru;; => nrel_format: format_html;; *);
=> nrel_note:
	[для синтеза гормонов щитовидной железе необходим йод, поэтому в Беларуси проводится йодирование пищевой соли] (* <- lang_ru;; *);
=> nrel_organ_system:
	endocrine_system;
=> nrel_function:
	[регуляция основного обмена, роста и развития организма] (* <- lang_ru;; *);;

pancreas
<- concept_mixed_secretion_gland;
<- concept_wit_entity;
=> nrel_main_idtf:
	[поджелудочная железа] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[pancreas] (* <- lang_en;; *);
=> nrel_definition:
	[железа смешанной секреции, экзокринная часть которой выделяет панкреатический сок в кишечник, а эндокринная (островки Лангерганса) - инсулин и глюкагон в кровь] (* <- lang_ru;; *);
=> nrel_note:
	[инсулин вырабатывают бета-клетки островков Лангерганса; их гибель приводит к сахарному диабету 1-го типа] (* <- lang_ru;; *);
=> nrel_organ_system:
	digestive_system;
=> nrel_organ_system:
	endocrine_system;
=> nrel_function:
	[выработка пищеварительных ферментов и гормонов инсулина и глюкагона] (* <- lang_ru;; *);;

liver
<- concept_exocrine_gland;
<- concept_wit_entity;
=> nrel_main_idtf:
	[печень] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[liver] (* <- lang_en;; *);
=> nrel_definition:
	[самая крупная железа человека, вырабатывающая жёлчь и выполняющая функции обезвреживания токсинов, синтеза белков плазмы и обмена веществ<br><img src="data:image/jpeg;base64," width="320" alt="liver">] (* <- lang_ru;; => nrel_format: format_html;; *);
=> nrel_note:
	[масса печени взрослого человека составляет около 1,5 кг] (* <- lang_ru;; *);
=> nrel_organ_system:
	digestive_system;
=> nrel_function:
	[выработка жёлчи, детоксикация, синтез белков плазмы крови, депонирование гликогена] (* <- lang_ru;; *);;

salivary_gland
<- concept_exocrine_gland;
<- concept_wit_entity;
=> nrel_main_idtf:
	[слюнная железа] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[salivary gland] (* <- lang_en;; *);
=> nrel_definition:
	[экзокринная железа полости рта, выделяющая слюну] (* <- lang_ru;; *);
=> nrel_note:
	[у человека три пары крупных слюнных желёз - околоушные, подчелюстные и подъязычные] (* <- lang_ru;; *);
=> nrel_organ_system:
	digestive_system;
=> nrel_function:
	[выработка слюны, увлажнение пищи и начальное расщепление углеводов] (* <- lang_ru;; *);;

