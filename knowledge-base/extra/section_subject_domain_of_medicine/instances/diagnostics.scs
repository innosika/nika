/* Экземпляры понятий: diagnostics */

auscultation
<- concept_physical_examination_method;
<- concept_wit_entity;
=> nrel_main_idtf:
	[аускультация] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[auscultation] (* <- lang_en;; *);
=> nrel_definition:
	[физикальный метод диагностики, заключающийся в выслушивании звуков, возникающих при работе внутренних органов, обычно с помощью стетоскопа] (* <- lang_ru;; *);
=> nrel_note:
	[метод предложен французским врачом Рене Лаэннеком в 1816 году] (* <- lang_ru;; *);
=> nrel_diagnostic_equipment:
	stethoscope;
=> nrel_examined_organ:
	lung;
=> nrel_examined_organ:
	heart;;

percussion
<- concept_physical_examination_method;
<- concept_wit_entity;
=> nrel_main_idtf:
	[перкуссия] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[percussion] (* <- lang_en;; *);
=> nrel_definition:
	[физикальный метод диагностики, основанный на выстукивании участков тела и оценке характера возникающих звуков] (* <- lang_ru;; *);
=> nrel_note:
	[метод введён в практику Леопольдом Ауэнбруггером в 1761 году] (* <- lang_ru;; *);
=> nrel_examined_organ:
	lung;;

electrocardiography
<- concept_functional_diagnostic_method;
<- concept_wit_entity;
=> nrel_main_idtf:
	[электрокардиография] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[electrocardiography] (* <- lang_en;; *);
=> nrel_idtf:
	[ЭКГ] (* <- lang_ru;; *);
=> nrel_definition:
	[функциональный метод диагностики, заключающийся в регистрации электрических потенциалов, возникающих при работе сердца<br><img src="data:image/jpeg;base64," width="320" alt="electrocardiography">] (* <- lang_ru;; => nrel_format: format_html;; *);
=> nrel_note:
	[за создание метода электрокардиографии Виллем Эйнтховен получил Нобелевскую премию 1924 года] (* <- lang_ru;; *);
=> nrel_diagnostic_equipment:
	electrocardiograph;
=> nrel_examined_organ:
	heart;;

spirometry
<- concept_functional_diagnostic_method;
<- concept_wit_entity;
=> nrel_main_idtf:
	[спирометрия] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[spirometry] (* <- lang_en;; *);
=> nrel_definition:
	[функциональный метод диагностики, измеряющий объёмные и скоростные показатели дыхания] (* <- lang_ru;; *);
=> nrel_note:
	[основной показатель при астме - объём форсированного выдоха за первую секунду (ОФВ1)] (* <- lang_ru;; *);
=> nrel_diagnostic_equipment:
	spirometer;
=> nrel_examined_organ:
	lung;;

chest_xray
<- concept_radiological_method;
<- concept_wit_entity;
=> nrel_main_idtf:
	[рентгенография органов грудной клетки] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[chest radiography] (* <- lang_en;; *);
=> nrel_idtf:
	[рентген грудной клетки] (* <- lang_ru;; *);
=> nrel_idtf:
	[рентгенография лёгких] (* <- lang_ru;; *);
=> nrel_definition:
	[рентгенологический метод диагностики, при котором получают проекционное изображение органов грудной клетки на плёнке или цифровом детекторе<br><img src="data:image/jpeg;base64," width="320" alt="chest_xray">] (* <- lang_ru;; => nrel_format: format_html;; *);
=> nrel_diagnostic_equipment:
	x_ray_machine;
=> nrel_examined_organ:
	lung;
=> nrel_examined_organ:
	heart;;

computed_tomography
<- concept_radiological_method;
<- concept_wit_entity;
=> nrel_main_idtf:
	[компьютерная томография] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[computed tomography] (* <- lang_en;; *);
=> nrel_idtf:
	[КТ] (* <- lang_ru;; *);
=> nrel_definition:
	[рентгенологический метод диагностики, при котором послойные изображения тела реконструируются компьютером по данным множества рентгеновских проекций] (* <- lang_ru;; *);
=> nrel_note:
	[метод разработан Годфри Хаунсфилдом и Алланом Кормаком, удостоенными Нобелевской премии 1979 года] (* <- lang_ru;; *);
=> nrel_diagnostic_equipment:
	ct_scanner;
=> nrel_examined_organ:
	lung;;

echocardiography
<- concept_ultrasound_method;
<- concept_wit_entity;
=> nrel_main_idtf:
	[эхокардиография] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[echocardiography] (* <- lang_en;; *);
=> nrel_idtf:
	[ЭхоКГ] (* <- lang_ru;; *);
=> nrel_idtf:
	[УЗИ сердца] (* <- lang_ru;; *);
=> nrel_definition:
	[ультразвуковой метод диагностики, позволяющий оценить структуру сердца, работу клапанов и сократимость миокарда<br><img src="data:image/jpeg;base64," width="320" alt="echocardiography">] (* <- lang_ru;; => nrel_format: format_html;; *);
=> nrel_diagnostic_equipment:
	ultrasound_machine;
=> nrel_examined_organ:
	heart;;

thyroid_ultrasound
<- concept_ultrasound_method;
<- concept_wit_entity;
=> nrel_main_idtf:
	[УЗИ щитовидной железы] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[thyroid ultrasound] (* <- lang_en;; *);
=> nrel_definition:
	[ультразвуковой метод диагностики, оценивающий размеры, структуру и кровоснабжение щитовидной железы] (* <- lang_ru;; *);
=> nrel_diagnostic_equipment:
	ultrasound_machine;
=> nrel_examined_organ:
	thyroid_gland;;

complete_blood_count
<- concept_laboratory_diagnostic_method;
<- concept_wit_entity;
=> nrel_main_idtf:
	[общий анализ крови] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[complete blood count] (* <- lang_en;; *);
=> nrel_idtf:
	[ОАК] (* <- lang_ru;; *);
=> nrel_definition:
	[лабораторный метод диагностики, определяющий количество клеток крови, концентрацию гемоглобина и скорость оседания эритроцитов] (* <- lang_ru;; *);
=> nrel_biomaterial:
	[капиллярная или венозная кровь] (* <- lang_ru;; *);
=> nrel_reference_value:
	[лейкоциты 4-9 тысяч в микролитре; гемоглобин 130-160 г/л у мужчин и 120-140 г/л у женщин] (* <- lang_ru;; *);
=> nrel_diagnostic_equipment:
	hematology_analyzer;;

blood_glucose_test
<- concept_laboratory_diagnostic_method;
<- concept_wit_entity;
=> nrel_main_idtf:
	[анализ крови на глюкозу] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[blood glucose test] (* <- lang_en;; *);
=> nrel_idtf:
	[глюкоза крови] (* <- lang_ru;; *);
=> nrel_definition:
	[лабораторный метод диагностики, определяющий концентрацию глюкозы в плазме крови натощак] (* <- lang_ru;; *);
=> nrel_biomaterial:
	[венозная кровь натощак] (* <- lang_ru;; *);
=> nrel_reference_value:
	[3,3-5,5 ммоль/л] (* <- lang_ru;; *);
=> nrel_diagnostic_equipment:
	glucometer;;

pcr_test
<- concept_laboratory_diagnostic_method;
<- concept_wit_entity;
=> nrel_main_idtf:
	[ПЦР-тест] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[PCR test] (* <- lang_en;; *);
=> nrel_idtf:
	[полимеразная цепная реакция] (* <- lang_ru;; *);
=> nrel_idtf:
	[ПЦР] (* <- lang_ru;; *);
=> nrel_definition:
	[лабораторный метод диагностики, выявляющий генетический материал возбудителя путём многократного копирования участка его ДНК или РНК] (* <- lang_ru;; *);
=> nrel_note:
	[метод полимеразной цепной реакции разработан Кэри Муллисом в 1983 году] (* <- lang_ru;; *);
=> nrel_biomaterial:
	[мазок из носоглотки и ротоглотки] (* <- lang_ru;; *);;

bacteriological_culture
<- concept_laboratory_diagnostic_method;
<- concept_wit_entity;
=> nrel_main_idtf:
	[бактериологический посев] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[bacteriological culture] (* <- lang_en;; *);
=> nrel_idtf:
	[бакпосев] (* <- lang_ru;; *);
=> nrel_definition:
	[лабораторный метод диагностики, при котором биоматериал высевают на питательные среды для выделения возбудителя и определения его чувствительности к антибиотикам] (* <- lang_ru;; *);
=> nrel_note:
	[рост микобактерий туберкулёза на плотных средах занимает от 3 до 8 недель] (* <- lang_ru;; *);
=> nrel_biomaterial:
	[мокрота, кровь, моча, мазки со слизистых] (* <- lang_ru;; *);;

troponin_test
<- concept_laboratory_diagnostic_method;
<- concept_wit_entity;
=> nrel_main_idtf:
	[тропониновый тест] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[troponin test] (* <- lang_en;; *);
=> nrel_definition:
	[лабораторный метод диагностики, определяющий концентрацию сердечного тропонина в крови как маркёра повреждения миокарда] (* <- lang_ru;; *);
=> nrel_biomaterial:
	[венозная кровь] (* <- lang_ru;; *);
=> nrel_reference_value:
	[тропонин I менее 0,04 нг/мл] (* <- lang_ru;; *);;

hbsag_test
<- concept_laboratory_diagnostic_method;
<- concept_wit_entity;
=> nrel_main_idtf:
	[анализ на HBsAg] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[HBsAg test] (* <- lang_en;; *);
=> nrel_idtf:
	[ИФА на HBsAg] (* <- lang_ru;; *);
=> nrel_definition:
	[лабораторный метод диагностики, выявляющий поверхностный антиген вируса гепатита B в сыворотке крови методом иммуноферментного анализа] (* <- lang_ru;; *);
=> nrel_biomaterial:
	[сыворотка венозной крови] (* <- lang_ru;; *);
=> nrel_reference_value:
	[отрицательный результат (антиген не обнаружен)] (* <- lang_ru;; *);;

