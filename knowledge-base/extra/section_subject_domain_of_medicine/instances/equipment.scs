/* Экземпляры понятий: equipment */

ct_scanner
<- concept_imaging_equipment;
<- concept_wit_entity;
=> nrel_main_idtf:
	[компьютерный томограф] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[CT scanner] (* <- lang_en;; *);
=> nrel_idtf:
	[КТ-сканер] (* <- lang_ru;; *);
=> nrel_definition:
	[аппарат для медицинской визуализации, выполняющий послойное рентгеновское сканирование тела с компьютерной реконструкцией изображений<br><img src="data:image/jpeg;base64," width="320" alt="ct_scanner">] (* <- lang_ru;; => nrel_format: format_html;; *);
=> nrel_note:
	[первый клинический компьютерный томограф установлен в лондонской больнице Аткинсона Морли в 1971 году] (* <- lang_ru;; *);;

ultrasound_machine
<- concept_imaging_equipment;
<- concept_wit_entity;
=> nrel_main_idtf:
	[ультразвуковой аппарат] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[ultrasound machine] (* <- lang_en;; *);
=> nrel_idtf:
	[аппарат УЗИ] (* <- lang_ru;; *);
=> nrel_idtf:
	[УЗИ-аппарат] (* <- lang_ru;; *);
=> nrel_definition:
	[аппарат для медицинской визуализации, формирующий изображение органов по отражённым ультразвуковым волнам<br><img src="data:image/jpeg;base64," width="320" alt="ultrasound_machine">] (* <- lang_ru;; => nrel_format: format_html;; *);;

x_ray_machine
<- concept_imaging_equipment;
<- concept_wit_entity;
=> nrel_main_idtf:
	[рентгеновский аппарат] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[X-ray machine] (* <- lang_en;; *);
=> nrel_definition:
	[аппарат для медицинской визуализации, формирующий изображение внутренних структур тела с помощью рентгеновского излучения] (* <- lang_ru;; *);;

electrocardiograph
<- concept_diagnostic_equipment;
<- concept_wit_entity;
=> nrel_main_idtf:
	[электрокардиограф] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[electrocardiograph] (* <- lang_en;; *);
=> nrel_definition:
	[диагностический прибор, регистрирующий электрическую активность сердца с электродов, наложенных на тело пациента] (* <- lang_ru;; *);;

stethoscope
<- concept_diagnostic_equipment;
<- concept_wit_entity;
=> nrel_main_idtf:
	[стетоскоп] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[stethoscope] (* <- lang_en;; *);
=> nrel_idtf:
	[фонендоскоп] (* <- lang_ru;; *);
=> nrel_definition:
	[диагностический инструмент для выслушивания звуков внутренних органов - сердца, лёгких, кишечника<br><img src="data:image/jpeg;base64," width="320" alt="stethoscope">] (* <- lang_ru;; => nrel_format: format_html;; *);
=> nrel_note:
	[стетоскоп изобретён Рене Лаэннеком в 1816 году; первый образец представлял собой бумажную трубку] (* <- lang_ru;; *);;

glucometer
<- concept_diagnostic_equipment;
<- concept_wit_entity;
=> nrel_main_idtf:
	[глюкометр] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[glucometer] (* <- lang_en;; *);
=> nrel_definition:
	[портативный прибор для измерения концентрации глюкозы в капиллярной крови<br><img src="data:image/jpeg;base64," width="320" alt="glucometer">] (* <- lang_ru;; => nrel_format: format_html;; *);
=> nrel_note:
	[глюкометр позволяет пациентам с диабетом самостоятельно контролировать уровень глюкозы] (* <- lang_ru;; *);;

spirometer
<- concept_diagnostic_equipment;
<- concept_wit_entity;
=> nrel_main_idtf:
	[спирометр] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[spirometer] (* <- lang_en;; *);
=> nrel_definition:
	[диагностический прибор для измерения объёма и скорости воздушного потока при дыхании] (* <- lang_ru;; *);;

hematology_analyzer
<- concept_diagnostic_equipment;
<- concept_wit_entity;
=> nrel_main_idtf:
	[гематологический анализатор] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[hematology analyzer] (* <- lang_en;; *);
=> nrel_definition:
	[лабораторный прибор, автоматически подсчитывающий клетки крови и определяющий показатели общего анализа крови] (* <- lang_ru;; *);;

ventilator
<- concept_therapeutic_equipment;
<- concept_wit_entity;
=> nrel_main_idtf:
	[аппарат искусственной вентиляции лёгких] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[mechanical ventilator] (* <- lang_en;; *);
=> nrel_idtf:
	[аппарат ИВЛ] (* <- lang_ru;; *);
=> nrel_definition:
	[лечебный аппарат, обеспечивающий принудительную подачу дыхательной смеси в лёгкие пациента при дыхательной недостаточности] (* <- lang_ru;; *);
=> nrel_note:
	[в период пандемии COVID-19 аппараты ИВЛ стали критически важным ресурсом отделений реанимации] (* <- lang_ru;; *);;

defibrillator
<- concept_therapeutic_equipment;
<- concept_wit_entity;
=> nrel_main_idtf:
	[дефибриллятор] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[defibrillator] (* <- lang_en;; *);
=> nrel_definition:
	[лечебный аппарат, устраняющий фибрилляцию желудочков сердца с помощью электрического разряда] (* <- lang_ru;; *);
=> nrel_note:
	[автоматические наружные дефибрилляторы размещают в общественных местах для использования неспециалистами] (* <- lang_ru;; *);;

