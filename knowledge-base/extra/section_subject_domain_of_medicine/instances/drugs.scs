/* Экземпляры понятий: drugs */

amoxicillin
<- concept_antibiotic;
<- concept_wit_entity;
=> nrel_main_idtf:
	[амоксициллин] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[amoxicillin] (* <- lang_en;; *);
=> nrel_definition:
	[полусинтетический антибиотик группы пенициллинов широкого спектра действия<br><img src="data:image/jpeg;base64," width="320" alt="amoxicillin">] (* <- lang_ru;; => nrel_format: format_html;; *);
=> nrel_note:
	[часто комбинируется с клавулановой кислотой для преодоления устойчивости бактерий] (* <- lang_ru;; *);
=> nrel_indication:
	pneumococcal_pneumonia;
=> nrel_target_pathogen:
	streptococcus_pneumoniae;
=> nrel_target_pathogen:
	escherichia_coli;
=> nrel_side_effect:
	nausea;
=> nrel_manufacturer:
	[Sandoz; в Беларуси - ОАО «Борисовский завод медицинских препаратов»] (* <- lang_ru;; *);;

azithromycin
<- concept_antibiotic;
<- concept_wit_entity;
=> nrel_main_idtf:
	[азитромицин] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[azithromycin] (* <- lang_en;; *);
=> nrel_idtf:
	[Сумамед] (* <- lang_ru;; *);
=> nrel_definition:
	[антибиотик группы макролидов, накапливающийся в тканях и применяемый при инфекциях дыхательных путей] (* <- lang_ru;; *);
=> nrel_indication:
	pneumococcal_pneumonia;
=> nrel_target_pathogen:
	streptococcus_pneumoniae;
=> nrel_target_pathogen:
	staphylococcus_aureus;
=> nrel_side_effect:
	nausea;
=> nrel_manufacturer:
	[Pliva (Teva)] (* <- lang_ru;; *);;

oseltamivir
<- concept_antiviral_drug;
<- concept_wit_entity;
=> nrel_main_idtf:
	[осельтамивир] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[oseltamivir] (* <- lang_en;; *);
=> nrel_idtf:
	[Тамифлю] (* <- lang_ru;; *);
=> nrel_definition:
	[противовирусное средство, ингибитор нейраминидазы вирусов гриппа A и B] (* <- lang_ru;; *);
=> nrel_indication:
	influenza_a_h1n1;
=> nrel_target_pathogen:
	influenza_a_virus;
=> nrel_side_effect:
	nausea;
=> nrel_manufacturer:
	[F. Hoffmann-La Roche] (* <- lang_ru;; *);;

remdesivir
<- concept_antiviral_drug;
<- concept_wit_entity;
=> nrel_main_idtf:
	[ремдесивир] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[remdesivir] (* <- lang_en;; *);
=> nrel_idtf:
	[Веклури] (* <- lang_ru;; *);
=> nrel_definition:
	[противовирусное средство, аналог нуклеотида, подавляющий РНК-полимеразу коронавирусов] (* <- lang_ru;; *);
=> nrel_indication:
	covid_19;
=> nrel_target_pathogen:
	sars_cov_2;
=> nrel_side_effect:
	nausea;
=> nrel_manufacturer:
	[Gilead Sciences] (* <- lang_ru;; *);;

ibuprofen
<- concept_analgesic;
<- concept_wit_entity;
=> nrel_main_idtf:
	[ибупрофен] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[ibuprofen] (* <- lang_en;; *);
=> nrel_idtf:
	[Нурофен] (* <- lang_ru;; *);
=> nrel_definition:
	[нестероидное противовоспалительное средство с обезболивающим, жаропонижающим и противовоспалительным действием<br><img src="data:image/jpeg;base64," width="320" alt="ibuprofen">] (* <- lang_ru;; => nrel_format: format_html;; *);
=> nrel_note:
	[входит в перечень основных лекарственных средств ВОЗ] (* <- lang_ru;; *);
=> nrel_indication:
	influenza_a_h1n1;
=> nrel_indication:
	covid_19;
=> nrel_side_effect:
	nausea;
=> nrel_manufacturer:
	[множество производителей; в Беларуси - ОАО «Борисовский завод медицинских препаратов»] (* <- lang_ru;; *);;

paracetamol
<- concept_analgesic;
<- concept_wit_entity;
=> nrel_main_idtf:
	[парацетамол] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[paracetamol] (* <- lang_en;; *);
=> nrel_idtf:
	[ацетаминофен] (* <- lang_ru;; *);
=> nrel_idtf:
	[Панадол] (* <- lang_ru;; *);
=> nrel_definition:
	[анальгетик-антипиретик центрального действия, применяемый при боли и лихорадке] (* <- lang_ru;; *);
=> nrel_note:
	[при передозировке парацетамол токсичен для печени] (* <- lang_ru;; *);
=> nrel_indication:
	influenza_a_h1n1;
=> nrel_indication:
	covid_19;
=> nrel_manufacturer:
	[множество производителей; в Беларуси - РУП «Белмедпрепараты»] (* <- lang_ru;; *);;

morphine
<- concept_analgesic;
<- concept_wit_entity;
=> nrel_main_idtf:
	[морфин] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[morphine] (* <- lang_en;; *);
=> nrel_definition:
	[опиоидный анальгетик, применяемый при интенсивной боли, в том числе при инфаркте миокарда] (* <- lang_ru;; *);
=> nrel_note:
	[морфин впервые выделен из опия Фридрихом Сертюрнером в 1804 году] (* <- lang_ru;; *);
=> nrel_indication:
	myocardial_infarction;
=> nrel_side_effect:
	nausea;
=> nrel_manufacturer:
	[РУП «Белмедпрепараты»] (* <- lang_ru;; *);;

insulin
<- concept_hormonal_drug;
<- concept_wit_entity;
=> nrel_main_idtf:
	[инсулин] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[insulin] (* <- lang_en;; *);
=> nrel_idtf:
	[инсулин человеческий] (* <- lang_ru;; *);
=> nrel_definition:
	[гормон поджелудочной железы и лекарственное средство на его основе, снижающее уровень глюкозы в крови<br><img src="data:image/jpeg;base64," width="320" alt="insulin">] (* <- lang_ru;; => nrel_format: format_html;; *);
=> nrel_note:
	[первое успешное применение инсулина для лечения диабета - 1922 год (Фредерик Бантинг и Чарлз Бест)] (* <- lang_ru;; *);
=> nrel_indication:
	type_1_diabetes;
=> nrel_indication:
	type_2_diabetes;
=> nrel_manufacturer:
	[Novo Nordisk, Sanofi, Eli Lilly; в Беларуси - РУП «Белмедпрепараты»] (* <- lang_ru;; *);;

budesonide
<- concept_hormonal_drug;
<- concept_wit_entity;
=> nrel_main_idtf:
	[будесонид] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[budesonide] (* <- lang_en;; *);
=> nrel_idtf:
	[Пульмикорт] (* <- lang_ru;; *);
=> nrel_definition:
	[глюкокортикоидное гормональное средство для ингаляционного применения при бронхиальной астме] (* <- lang_ru;; *);
=> nrel_indication:
	bronchial_asthma;
=> nrel_manufacturer:
	[AstraZeneca] (* <- lang_ru;; *);;

bcg
<- concept_live_vaccine;
<- concept_wit_entity;
=> nrel_main_idtf:
	[БЦЖ] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[BCG vaccine] (* <- lang_en;; *);
=> nrel_idtf:
	[вакцина туберкулёзная] (* <- lang_ru;; *);
=> nrel_idtf:
	[вакцина БЦЖ] (* <- lang_ru;; *);
=> nrel_definition:
	[живая вакцина против туберкулёза из ослабленного штамма Mycobacterium bovis<br><img src="data:image/jpeg;base64," width="320" alt="bcg">] (* <- lang_ru;; => nrel_format: format_html;; *);
=> nrel_note:
	[в Республике Беларусь вакцинация БЦЖ проводится новорождённым на 3-5 день жизни] (* <- lang_ru;; *);
=> nrel_indication:
	tuberculosis;
=> nrel_manufacturer:
	[Japan BCG Laboratory; АО «Микроген» (Россия)] (* <- lang_ru;; *);;

vaxigrip_tetra
<- concept_inactivated_vaccine;
<- concept_wit_entity;
=> nrel_main_idtf:
	[Ваксигрип Тетра] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[Vaxigrip Tetra] (* <- lang_en;; *);
=> nrel_idtf:
	[четырёхвалентная вакцина против гриппа] (* <- lang_ru;; *);
=> nrel_definition:
	[инактивированная сплит-вакцина против гриппа, содержащая антигены двух штаммов вируса гриппа A и двух штаммов вируса гриппа B] (* <- lang_ru;; *);
=> nrel_note:
	[состав вакцины ежегодно обновляется по рекомендациям ВОЗ] (* <- lang_ru;; *);
=> nrel_indication:
	influenza_a_h1n1;
=> nrel_manufacturer:
	[Sanofi Pasteur] (* <- lang_ru;; *);;

comirnaty
<- concept_mrna_vaccine;
<- concept_wit_entity;
=> nrel_main_idtf:
	[Комирнати] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[Comirnaty] (* <- lang_en;; *);
=> nrel_idtf:
	[Comirnaty] (* <- lang_en;; *);
=> nrel_idtf:
	[вакцина Pfizer] (* <- lang_ru;; *);
=> nrel_definition:
	[мРНК-вакцина против COVID-19, кодирующая спайк-белок вируса SARS-CoV-2] (* <- lang_ru;; *);
=> nrel_note:
	[первая мРНК-вакцина, одобренная для массового применения (декабрь 2020 года)] (* <- lang_ru;; *);
=> nrel_indication:
	covid_19;
=> nrel_manufacturer:
	[Pfizer, BioNTech] (* <- lang_ru;; *);;

engerix_b
<- concept_recombinant_vaccine;
<- concept_wit_entity;
=> nrel_main_idtf:
	[Энджерикс B] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[Engerix-B] (* <- lang_en;; *);
=> nrel_idtf:
	[вакцина против гепатита B] (* <- lang_ru;; *);
=> nrel_definition:
	[рекомбинантная вакцина против гепатита B, содержащая поверхностный антиген HBsAg, полученный в дрожжевых клетках] (* <- lang_ru;; *);
=> nrel_note:
	[в Беларуси вакцинация против гепатита B входит в календарь прививок и начинается в первые сутки жизни] (* <- lang_ru;; *);
=> nrel_indication:
	hepatitis_b;
=> nrel_manufacturer:
	[GlaxoSmithKline] (* <- lang_ru;; *);;

