/* Экземпляры понятий: institutions */

polyclinic_34
<- concept_outpatient_institution;
<- concept_wit_entity;
=> nrel_main_idtf:
	[34-я центральная районная клиническая поликлиника Советского района г. Минска] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[34th Central District Clinical Polyclinic of Minsk] (* <- lang_en;; *);
=> nrel_idtf:
	[34-я поликлиника] (* <- lang_ru;; *);
=> nrel_definition:
	[амбулаторно-поликлиническое учреждение, оказывающее первичную медицинскую помощь взрослому населению Советского района Минска] (* <- lang_ru;; *);
=> nrel_location:
	[г. Минск, ул. Кульман, 22] (* <- lang_ru;; *);;

hospital_3
<- concept_multidisciplinary_hospital;
<- concept_wit_entity;
=> nrel_main_idtf:
	[3-я городская клиническая больница имени Е. В. Клумова] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[3rd City Clinical Hospital named after E. V. Klumov] (* <- lang_en;; *);
=> nrel_idtf:
	[3-я городская клиническая больница] (* <- lang_ru;; *);
=> nrel_definition:
	[многопрофильная больница в центре Минска, одно из старейших лечебных учреждений города, основанное в 1801 году<br><img src="data:image/jpeg;base64," width="320" alt="hospital_3">] (* <- lang_ru;; => nrel_format: format_html;; *);
=> nrel_note:
	[больница носит имя врача-подпольщика Евгения Владимировича Клумова, работавшего в ней в годы немецкой оккупации] (* <- lang_ru;; *);
=> nrel_location:
	[г. Минск, ул. Ленина, 30] (* <- lang_ru;; *);;

rnpc_cardiology
<- concept_specialized_hospital;
<- concept_wit_entity;
=> nrel_main_idtf:
	[РНПЦ «Кардиология»] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[Republican Scientific and Practical Centre "Cardiology"] (* <- lang_en;; *);
=> nrel_idtf:
	[Республиканский научно-практический центр «Кардиология»] (* <- lang_ru;; *);
=> nrel_definition:
	[специализированная больница - Республиканский научно-практический центр, оказывающий высокотехнологичную кардиологическую и кардиохирургическую помощь] (* <- lang_ru;; *);
=> nrel_note:
	[в центре выполняются операции трансплантации сердца] (* <- lang_ru;; *);
=> nrel_location:
	[г. Минск, ул. Розы Люксембург, 110] (* <- lang_ru;; *);;

infectious_hospital
<- concept_specialized_hospital;
<- concept_wit_entity;
=> nrel_main_idtf:
	[Городская клиническая инфекционная больница г. Минска] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[Minsk City Clinical Infectious Diseases Hospital] (* <- lang_en;; *);
=> nrel_idtf:
	[инфекционная больница] (* <- lang_ru;; *);
=> nrel_definition:
	[специализированная больница, оказывающая помощь взрослым пациентам с инфекционными заболеваниями] (* <- lang_ru;; *);
=> nrel_location:
	[г. Минск, ул. Кропоткина, 76] (* <- lang_ru;; *);;

rnpc_pulmonology
<- concept_specialized_hospital;
<- concept_wit_entity;
=> nrel_main_idtf:
	[РНПЦ пульмонологии и фтизиатрии] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[Republican Scientific and Practical Centre of Pulmonology and Phthisiology] (* <- lang_en;; *);
=> nrel_definition:
	[специализированная больница - Республиканский научно-практический центр, оказывающий помощь пациентам с туберкулёзом и другими заболеваниями органов дыхания] (* <- lang_ru;; *);
=> nrel_location:
	[г. Минск, Долгиновский тракт, 157] (* <- lang_ru;; *);;

