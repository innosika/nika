/* Экземпляры понятий: diseases */

influenza_a_h1n1
<- concept_influenza;
<- concept_wit_entity;
=> nrel_main_idtf:
	[грипп A(H1N1)] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[influenza A(H1N1)] (* <- lang_en;; *);
=> nrel_idtf:
	[свиной грипп] (* <- lang_ru;; *);
=> nrel_idtf:
	[пандемический грипп 2009 года] (* <- lang_ru;; *);
=> nrel_definition:
	[разновидность гриппа, вызываемая вирусом гриппа A подтипа H1N1; штамм A(H1N1)pdm09 стал причиной пандемии 2009 года<br><img src="data:image/jpeg;base64," width="320" alt="influenza_a_h1n1">] (* <- lang_ru;; => nrel_format: format_html;; *);
=> nrel_note:
	[пандемический штамм A(H1N1)pdm09 с 2010 года включается в состав сезонных вакцин против гриппа] (* <- lang_ru;; *);
=> nrel_pathogen:
	influenza_a_virus;
=> nrel_symptom:
	fever;
=> nrel_symptom:
	cough;
=> nrel_symptom:
	headache;
=> nrel_symptom:
	weakness;
=> nrel_syndrome:
	intoxication_syndrome;
=> nrel_affected_organ:
	lung;
=> nrel_complication:
	pneumococcal_pneumonia;
=> nrel_icd_code:
	[J09] (* <- lang_ru;; *);
=> nrel_incubation_period:
	[от 1 до 4 суток, в среднем 2 суток] (* <- lang_ru;; *);
=> nrel_transmission_route:
	[воздушно-капельный, реже контактно-бытовой] (* <- lang_ru;; *);
=> nrel_diagnostic_method:
	pcr_test;
=> nrel_diagnostic_method:
	auscultation;
=> nrel_diagnostic_method:
	complete_blood_count;
=> nrel_treatment_method:
	antiviral_therapy;
=> nrel_treatment_method:
	antipyretic_therapy;
=> nrel_specialist:
	infectious_disease_physician;
=> nrel_specialist:
	therapist;
=> nrel_prevention_vaccine:
	vaxigrip_tetra;;

covid_19
<- concept_acute_respiratory_viral_infection;
<- concept_wit_entity;
=> nrel_main_idtf:
	[COVID-19] (* <- lang_ru;; *);
=> nrel_idtf:
	[коронавирусная инфекция COVID-19] (* <- lang_ru;; *);
=> nrel_idtf:
	[ковид] (* <- lang_ru;; *);
=> nrel_definition:
	[острая респираторная вирусная инфекция, вызываемая коронавирусом SARS-CoV-2 и впервые выявленная в декабре 2019 года в городе Ухань (Китай)] (* <- lang_ru;; *);
=> nrel_note:
	[11 марта 2020 года Всемирная организация здравоохранения объявила вспышку COVID-19 пандемией] (* <- lang_ru;; *);
=> nrel_pathogen:
	sars_cov_2;
=> nrel_symptom:
	fever;
=> nrel_symptom:
	cough;
=> nrel_symptom:
	dyspnea;
=> nrel_symptom:
	weakness;
=> nrel_syndrome:
	intoxication_syndrome;
=> nrel_affected_organ:
	lung;
=> nrel_icd_code:
	[U07.1] (* <- lang_ru;; *);
=> nrel_incubation_period:
	[от 2 до 14 суток, в среднем 5-6 суток] (* <- lang_ru;; *);
=> nrel_transmission_route:
	[воздушно-капельный и контактный] (* <- lang_ru;; *);
=> nrel_diagnostic_method:
	pcr_test;
=> nrel_diagnostic_method:
	computed_tomography;
=> nrel_treatment_method:
	antiviral_therapy;
=> nrel_treatment_method:
	antipyretic_therapy;
=> nrel_treatment_method:
	mechanical_ventilation;
=> nrel_specialist:
	infectious_disease_physician;
=> nrel_specialist:
	pulmonologist;
=> nrel_prevention_vaccine:
	comirnaty;;

hepatitis_b
<- concept_viral_disease;
<- concept_wit_entity;
=> nrel_main_idtf:
	[вирусный гепатит B] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[hepatitis B] (* <- lang_en;; *);
=> nrel_idtf:
	[гепатит B] (* <- lang_ru;; *);
=> nrel_definition:
	[вирусное заболевание, вызываемое вирусом гепатита B и поражающее печень с развитием воспаления, а при хроническом течении - цирроза и рака печени] (* <- lang_ru;; *);
=> nrel_note:
	[по данным ВОЗ, около 254 миллионов человек в мире живут с хронической инфекцией гепатита B] (* <- lang_ru;; *);
=> nrel_pathogen:
	hepatitis_b_virus;
=> nrel_symptom:
	weakness;
=> nrel_symptom:
	nausea;
=> nrel_affected_organ:
	liver;
=> nrel_icd_code:
	[B16] (* <- lang_ru;; *);
=> nrel_incubation_period:
	[от 30 до 180 суток, в среднем 75 суток] (* <- lang_ru;; *);
=> nrel_transmission_route:
	[парентеральный (через кровь), половой, вертикальный (от матери ребёнку)] (* <- lang_ru;; *);
=> nrel_diagnostic_method:
	hbsag_test;
=> nrel_treatment_method:
	antiviral_therapy;
=> nrel_specialist:
	infectious_disease_physician;
=> nrel_prevention_vaccine:
	engerix_b;;

tuberculosis
<- concept_bacterial_disease;
<- concept_wit_entity;
=> nrel_main_idtf:
	[туберкулёз] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[tuberculosis] (* <- lang_en;; *);
=> nrel_idtf:
	[туберкулез] (* <- lang_ru;; *);
=> nrel_definition:
	[бактериальное заболевание, вызываемое микобактериями туберкулёза и поражающее чаще всего лёгкие<br><img src="data:image/jpeg;base64," width="320" alt="tuberculosis">] (* <- lang_ru;; => nrel_format: format_html;; *);
=> nrel_note:
	[по данным ВОЗ, туберкулёз остаётся одной из главных инфекционных причин смерти в мире: ежегодно заболевают около 10 миллионов человек] (* <- lang_ru;; *);
=> nrel_pathogen:
	mycobacterium_tuberculosis;
=> nrel_symptom:
	cough;
=> nrel_symptom:
	fever;
=> nrel_symptom:
	weakness;
=> nrel_syndrome:
	intoxication_syndrome;
=> nrel_affected_organ:
	lung;
=> nrel_icd_code:
	[A15-A19] (* <- lang_ru;; *);
=> nrel_incubation_period:
	[от 3 до 12 недель] (* <- lang_ru;; *);
=> nrel_transmission_route:
	[воздушно-капельный] (* <- lang_ru;; *);
=> nrel_diagnostic_method:
	chest_xray;
=> nrel_diagnostic_method:
	bacteriological_culture;
=> nrel_treatment_method:
	antibiotic_therapy;
=> nrel_specialist:
	phthisiatrician;
=> nrel_prevention_vaccine:
	bcg;;

pneumococcal_pneumonia
<- concept_bacterial_disease;
<- concept_wit_entity;
=> nrel_main_idtf:
	[пневмококковая пневмония] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[pneumococcal pneumonia] (* <- lang_en;; *);
=> nrel_definition:
	[бактериальное заболевание, при котором пневмококк вызывает воспаление лёгочной ткани с накоплением экссудата в альвеолах] (* <- lang_ru;; *);
=> nrel_note:
	[пневмококк - самая частая причина внебольничной пневмонии у взрослых] (* <- lang_ru;; *);
=> nrel_pathogen:
	streptococcus_pneumoniae;
=> nrel_symptom:
	fever;
=> nrel_symptom:
	cough;
=> nrel_symptom:
	dyspnea;
=> nrel_symptom:
	leukocytosis;
=> nrel_syndrome:
	intoxication_syndrome;
=> nrel_affected_organ:
	lung;
=> nrel_icd_code:
	[J13] (* <- lang_ru;; *);
=> nrel_incubation_period:
	[от 1 до 3 суток] (* <- lang_ru;; *);
=> nrel_transmission_route:
	[воздушно-капельный] (* <- lang_ru;; *);
=> nrel_diagnostic_method:
	chest_xray;
=> nrel_diagnostic_method:
	auscultation;
=> nrel_diagnostic_method:
	complete_blood_count;
=> nrel_treatment_method:
	antibiotic_therapy;
=> nrel_treatment_method:
	antipyretic_therapy;
=> nrel_specialist:
	therapist;
=> nrel_specialist:
	pulmonologist;;

myocardial_infarction
<- concept_ischemic_heart_disease;
<- concept_wit_entity;
=> nrel_main_idtf:
	[инфаркт миокарда] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[myocardial infarction] (* <- lang_en;; *);
=> nrel_idtf:
	[инфаркт] (* <- lang_ru;; *);
=> nrel_idtf:
	[сердечный приступ] (* <- lang_ru;; *);
=> nrel_definition:
	[форма ишемической болезни сердца, при которой из-за острого нарушения коронарного кровотока развивается некроз участка сердечной мышцы<br><img src="data:image/jpeg;base64," width="320" alt="myocardial_infarction">] (* <- lang_ru;; => nrel_format: format_html;; *);
=> nrel_note:
	[при инфаркте с подъёмом сегмента ST кровоток стремятся восстановить в первые 120 минут от начала болей] (* <- lang_ru;; *);
=> nrel_symptom:
	chest_pain;
=> nrel_symptom:
	dyspnea;
=> nrel_symptom:
	st_elevation;
=> nrel_syndrome:
	acute_coronary_syndrome;
=> nrel_affected_organ:
	heart;
=> nrel_icd_code:
	[I21] (* <- lang_ru;; *);
=> nrel_diagnostic_method:
	electrocardiography;
=> nrel_diagnostic_method:
	echocardiography;
=> nrel_diagnostic_method:
	troponin_test;
=> nrel_treatment_method:
	coronary_stenting;
=> nrel_treatment_method:
	coronary_bypass_surgery;
=> nrel_treatment_method:
	analgesic_therapy;
=> nrel_treatment_method:
	defibrillation;
=> nrel_specialist:
	cardiologist;
=> nrel_specialist:
	cardiac_surgeon;;

angina_pectoris
<- concept_ischemic_heart_disease;
<- concept_wit_entity;
=> nrel_main_idtf:
	[стенокардия] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[angina pectoris] (* <- lang_en;; *);
=> nrel_idtf:
	[грудная жаба] (* <- lang_ru;; *);
=> nrel_definition:
	[форма ишемической болезни сердца, проявляющаяся приступами загрудинной боли при физической или эмоциональной нагрузке, проходящими в покое или после приёма нитроглицерина] (* <- lang_ru;; *);
=> nrel_note:
	[устаревшее название стенокардии - «грудная жаба»] (* <- lang_ru;; *);
=> nrel_symptom:
	chest_pain;
=> nrel_symptom:
	dyspnea;
=> nrel_affected_organ:
	heart;
=> nrel_complication:
	myocardial_infarction;
=> nrel_icd_code:
	[I20] (* <- lang_ru;; *);
=> nrel_diagnostic_method:
	electrocardiography;
=> nrel_diagnostic_method:
	echocardiography;
=> nrel_treatment_method:
	coronary_stenting;
=> nrel_specialist:
	cardiologist;;

type_1_diabetes
<- concept_diabetes_mellitus;
<- concept_wit_entity;
=> nrel_main_idtf:
	[сахарный диабет 1-го типа] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[type 1 diabetes mellitus] (* <- lang_en;; *);
=> nrel_idtf:
	[диабет 1 типа] (* <- lang_ru;; *);
=> nrel_idtf:
	[инсулинозависимый сахарный диабет] (* <- lang_ru;; *);
=> nrel_definition:
	[сахарный диабет, развивающийся вследствие аутоиммунного разрушения бета-клеток поджелудочной железы и абсолютного дефицита инсулина] (* <- lang_ru;; *);
=> nrel_note:
	[чаще манифестирует в детском и молодом возрасте; пациенты пожизненно нуждаются в инсулинотерапии] (* <- lang_ru;; *);
=> nrel_symptom:
	hyperglycemia;
=> nrel_symptom:
	weakness;
=> nrel_affected_organ:
	pancreas;
=> nrel_icd_code:
	[E10] (* <- lang_ru;; *);
=> nrel_diagnostic_method:
	blood_glucose_test;
=> nrel_treatment_method:
	insulin_therapy;
=> nrel_treatment_method:
	diet_therapy;
=> nrel_specialist:
	endocrinologist;;

type_2_diabetes
<- concept_diabetes_mellitus;
<- concept_wit_entity;
=> nrel_main_idtf:
	[сахарный диабет 2-го типа] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[type 2 diabetes mellitus] (* <- lang_en;; *);
=> nrel_idtf:
	[диабет 2 типа] (* <- lang_ru;; *);
=> nrel_idtf:
	[инсулинонезависимый сахарный диабет] (* <- lang_ru;; *);
=> nrel_definition:
	[сахарный диабет, обусловленный инсулинорезистентностью тканей и относительной недостаточностью инсулина, развивающийся чаще у взрослых с избыточной массой тела] (* <- lang_ru;; *);
=> nrel_note:
	[составляет около 90 % всех случаев сахарного диабета] (* <- lang_ru;; *);
=> nrel_symptom:
	hyperglycemia;
=> nrel_symptom:
	weakness;
=> nrel_affected_organ:
	pancreas;
=> nrel_complication:
	myocardial_infarction;
=> nrel_icd_code:
	[E11] (* <- lang_ru;; *);
=> nrel_diagnostic_method:
	blood_glucose_test;
=> nrel_treatment_method:
	diet_therapy;
=> nrel_treatment_method:
	insulin_therapy;
=> nrel_specialist:
	endocrinologist;;

bronchial_asthma
<- concept_chronic_respiratory_disease;
<- concept_wit_entity;
=> nrel_main_idtf:
	[бронхиальная астма] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[bronchial asthma] (* <- lang_en;; *);
=> nrel_idtf:
	[астма] (* <- lang_ru;; *);
=> nrel_definition:
	[хроническое воспалительное заболевание дыхательных путей, проявляющееся приступами удушья, свистящими хрипами и кашлем вследствие обратимой обструкции бронхов] (* <- lang_ru;; *);
=> nrel_note:
	[по данным ВОЗ, в 2019 году астмой страдали около 262 миллионов человек в мире] (* <- lang_ru;; *);
=> nrel_symptom:
	dyspnea;
=> nrel_symptom:
	cough;
=> nrel_symptom:
	wheezing;
=> nrel_syndrome:
	bronchial_obstruction_syndrome;
=> nrel_affected_organ:
	lung;
=> nrel_icd_code:
	[J45] (* <- lang_ru;; *);
=> nrel_diagnostic_method:
	spirometry;
=> nrel_diagnostic_method:
	auscultation;
=> nrel_treatment_method:
	glucocorticoid_therapy;
=> nrel_specialist:
	pulmonologist;
=> nrel_specialist:
	therapist;;

