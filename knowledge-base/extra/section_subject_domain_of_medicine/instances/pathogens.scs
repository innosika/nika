/* Экземпляры понятий: pathogens */

influenza_a_virus
<- concept_rna_virus;
<- concept_wit_entity;
=> nrel_main_idtf:
	[вирус гриппа A] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[influenza A virus] (* <- lang_en;; *);
=> nrel_definition:
	[РНК-содержащий вирус семейства ортомиксовирусов, вызывающий грипп у человека и животных; подтипы различают по поверхностным белкам гемагглютинину (H) и нейраминидазе (N)<br><img src="data:image/jpeg;base64," width="320" alt="influenza_a_virus">] (* <- lang_ru;; => nrel_format: format_html;; *);
=> nrel_note:
	[именно вирусы гриппа A вызывают пандемии благодаря способности к реассортации генов] (* <- lang_ru;; *);
=> nrel_discoverer:
	[выделен в 1933 году Уилсоном Смитом, Кристофером Эндрюсом и Патриком Лейдлоу] (* <- lang_ru;; *);;

sars_cov_2
<- concept_rna_virus;
<- concept_wit_entity;
=> nrel_main_idtf:
	[SARS-CoV-2] (* <- lang_ru;; *);
=> nrel_idtf:
	[коронавирус SARS-CoV-2] (* <- lang_ru;; *);
=> nrel_idtf:
	[коронавирус] (* <- lang_ru;; *);
=> nrel_definition:
	[РНК-содержащий вирус семейства коронавирусов, возбудитель COVID-19<br><img src="data:image/jpeg;base64," width="320" alt="sars_cov_2">] (* <- lang_ru;; => nrel_format: format_html;; *);
=> nrel_note:
	[название расшифровывается как «коронавирус тяжёлого острого респираторного синдрома 2»] (* <- lang_ru;; *);
=> nrel_discoverer:
	[идентифицирован в январе 2020 года группой китайских учёных под руководством Чжан Юнчжэня] (* <- lang_ru;; *);;

hepatitis_b_virus
<- concept_dna_virus;
<- concept_wit_entity;
=> nrel_main_idtf:
	[вирус гепатита B] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[hepatitis B virus] (* <- lang_en;; *);
=> nrel_idtf:
	[HBV] (* <- lang_en;; *);
=> nrel_definition:
	[ДНК-содержащий вирус семейства гепаднавирусов, поражающий клетки печени] (* <- lang_ru;; *);
=> nrel_note:
	[вирус чрезвычайно устойчив во внешней среде и сохраняет заразность в высохшей крови до недели] (* <- lang_ru;; *);
=> nrel_discoverer:
	[поверхностный антиген вируса открыт Барухом Бламбергом в 1965 году (Нобелевская премия 1976 года)] (* <- lang_ru;; *);;

mycobacterium_tuberculosis
<- concept_gram_positive_bacterium;
<- concept_wit_entity;
=> nrel_main_idtf:
	[микобактерия туберкулёза] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[Mycobacterium tuberculosis] (* <- lang_en;; *);
=> nrel_idtf:
	[палочка Коха] (* <- lang_ru;; *);
=> nrel_idtf:
	[Mycobacterium tuberculosis] (* <- lang_en;; *);
=> nrel_definition:
	[кислотоустойчивая палочковидная бактерия, возбудитель туберкулёза<br><img src="data:image/jpeg;base64," width="320" alt="mycobacterium_tuberculosis">] (* <- lang_ru;; => nrel_format: format_html;; *);
=> nrel_note:
	[из-за особого строения клеточной стенки микобактерии плохо окрашиваются по Граму и выявляются окраской по Цилю-Нильсену] (* <- lang_ru;; *);
=> nrel_discoverer:
	[Роберт Кох, 24 марта 1882 года] (* <- lang_ru;; *);;

streptococcus_pneumoniae
<- concept_gram_positive_bacterium;
<- concept_wit_entity;
=> nrel_main_idtf:
	[пневмококк] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[Streptococcus pneumoniae] (* <- lang_en;; *);
=> nrel_idtf:
	[Streptococcus pneumoniae] (* <- lang_en;; *);
=> nrel_definition:
	[грамположительная бактерия, возбудитель пневмонии, отита, синусита и менингита] (* <- lang_ru;; *);
=> nrel_discoverer:
	[выделен независимо Луи Пастером и Джорджем Стернбергом в 1881 году] (* <- lang_ru;; *);;

staphylococcus_aureus
<- concept_gram_positive_bacterium;
<- concept_wit_entity;
=> nrel_main_idtf:
	[золотистый стафилококк] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[Staphylococcus aureus] (* <- lang_en;; *);
=> nrel_idtf:
	[Staphylococcus aureus] (* <- lang_en;; *);
=> nrel_definition:
	[грамположительная шаровидная бактерия, возбудитель гнойно-воспалительных заболеваний кожи, пневмонии и сепсиса<br><img src="data:image/jpeg;base64," width="320" alt="staphylococcus_aureus">] (* <- lang_ru;; => nrel_format: format_html;; *);
=> nrel_note:
	[метициллин-резистентный золотистый стафилококк (MRSA) - одна из главных проблем антибиотикорезистентности] (* <- lang_ru;; *);
=> nrel_discoverer:
	[Александр Огстон, 1880 год] (* <- lang_ru;; *);;

escherichia_coli
<- concept_gram_negative_bacterium;
<- concept_wit_entity;
=> nrel_main_idtf:
	[кишечная палочка] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[Escherichia coli] (* <- lang_en;; *);
=> nrel_idtf:
	[Escherichia coli] (* <- lang_en;; *);
=> nrel_definition:
	[грамотрицательная палочковидная бактерия, обитающая в кишечнике человека; патогенные штаммы вызывают кишечные и мочевые инфекции] (* <- lang_ru;; *);
=> nrel_note:
	[кишечная палочка - основной модельный организм молекулярной биологии и биотехнологии] (* <- lang_ru;; *);
=> nrel_discoverer:
	[Теодор Эшерих, 1885 год] (* <- lang_ru;; *);;

