/* Экземпляры понятий: workers */

therapist
<- concept_therapeutic_physician;
<- concept_wit_entity;
=> nrel_main_idtf:
	[врач-терапевт] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[general physician] (* <- lang_en;; *);
=> nrel_idtf:
	[терапевт] (* <- lang_ru;; *);
=> nrel_definition:
	[врач терапевтического профиля, оказывающий первичную медицинскую помощь взрослым при внутренних болезнях] (* <- lang_ru;; *);
=> nrel_workplace:
	polyclinic_34;;

