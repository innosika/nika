/* Раздел базы знаний ЛР2 (вариант «Космос»): классы сообщений и правила их классификации. */

section_space_messages
=> nrel_main_idtf:
	[Раздел. Классы сообщений на космическую тему] (* <- lang_ru;; *);
	[Section. Classes of messages on a space topic] (* <- lang_en;; *);
<- atomic_section;
-> rrel_key_sc_element:
	concept_space_message;
	concept_message_about_celestial_body_properties;
	concept_message_about_space_exploration;
	concept_message_about_orbit;
	concept_message_about_satellites;
	concept_message_about_physical_parameters;
	concept_message_about_discovery;
	concept_message_about_constellation;
	concept_message_about_space_mission;
	lr_classify_poekhali_message;
	lr_classify_known_planets_message;
	lr_classify_known_space_objects_message;
	lr_classify_known_spacecraft_message;;
