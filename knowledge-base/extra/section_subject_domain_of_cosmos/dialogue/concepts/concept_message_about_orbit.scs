concept_message_about_orbit
<- sc_node_class;
=> nrel_main_idtf:
	[сообщение об орбите космического объекта] (* <- lang_ru;; *);
	[message about the orbit of a space object] (* <- lang_en;; *);
=> nrel_wit_ai_idtf:
	[about_orbit];
<= nrel_inclusion:
	concept_message_about_celestial_body_properties;
=> nrel_definition:
	[сообщение о свойствах небесного тела, в котором запрашивается, вокруг какого объекта обращается указанный космический объект, период его обращения или расстояние до Солнца] (* <- lang_ru;; *);
=> nrel_note:
	[пример сообщения: «Вокруг чего обращается Луна?»; выделяемая сущность (роль rrel_entity): космический объект] (* <- lang_ru;; *);
<- rrel_key_sc_element:
	...
	(*
		=> nrel_main_idtf:
			[Опр. (сообщение об орбите космического объекта)] (* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
			...
			(*
				-> rrel_example:
					[Сообщение об орбите космического объекта - сообщение о свойствах небесного тела, в котором запрашивается, вокруг какого объекта обращается указанный космический объект, период его обращения или расстояние до Солнца.] (* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
		{
			concept_message_about_celestial_body_properties;
			nrel_orbit;
			nrel_orbital_period;
			nrel_distance_from_sun;
			rrel_entity
		};;
	*);;
