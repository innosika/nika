/* Исследуемые отношения раздела «Космос» (ЛР1). В ЛР1 их определение задано только структурой
   «Опр. (…)», а шаблон фразы ответа NIKA на «Что такое …?» использует связку nrel_definition,
   поэтому текст определения продублирован связкой; отношения добавлены в concept_wit_entity. */

nrel_discoverer
<- concept_wit_entity;
=> nrel_definition:
	[бинарное ориентированное отношение, связывающее космический объект с именем человека или названием коллектива, впервые обнаружившего этот объект] (* <- lang_ru;; *);
=> nrel_note:
	[в разделе «Космос» связки заданы для 7 объектов, например: Европа — Галилео Галилей] (* <- lang_ru;; *);;

nrel_discovery_date
<- concept_wit_entity;
=> nrel_definition:
	[бинарное ориентированное отношение, связывающее космический объект с датой, когда он был впервые обнаружен и зарегистрирован] (* <- lang_ru;; *);
=> nrel_note:
	[в разделе «Космос» связки заданы для 5 пар объектов, например: Фобос — 18 августа 1877 года] (* <- lang_ru;; *);;

nrel_distance_from_sun
<- concept_wit_entity;
=> nrel_definition:
	[бинарное ориентированное отношение, связывающее космический объект со значением большой полуоси его орбиты, выраженным в астрономических единицах или километрах] (* <- lang_ru;; *);
=> nrel_note:
	[в разделе «Космос» связки заданы для 6 пар объектов, например: Земля — 1 а.е. (около 149,6 млн км)] (* <- lang_ru;; *);;

nrel_equatorial_radius
<- concept_wit_entity;
=> nrel_definition:
	[бинарное ориентированное отношение, связывающее космический объект со значением его радиуса в плоскости экватора, выраженным в километрах] (* <- lang_ru;; *);
=> nrel_note:
	[в разделе «Космос» связки заданы для 6 пар объектов, например: Луна — 1738,1 км] (* <- lang_ru;; *);;

nrel_launch_date
<- concept_wit_entity;
=> nrel_definition:
	[бинарное ориентированное отношение, связывающее искусственный космический объект с датой его выведения в космическое пространство] (* <- lang_ru;; *);
=> nrel_note:
	[в разделе «Космос» связки заданы для 6 пар объектов, например: Спутник-1 — 4 октября 1957 года] (* <- lang_ru;; *);;

nrel_launch_site
<- concept_wit_entity;
=> nrel_definition:
	[бинарное ориентированное отношение, связывающее космическую миссию с космодромом, с которого был осуществлён запуск] (* <- lang_ru;; *);
=> nrel_note:
	[в разделе «Космос» связки заданы для 4 пар объектов, например: Восток-1 — Байконур] (* <- lang_ru;; *);;

nrel_located_in_constellation
<- concept_wit_entity;
=> nrel_definition:
	[бинарное ориентированное отношение, связывающее космический объект с тем созвездием, в границах которого он наблюдается на небесной сфере] (* <- lang_ru;; *);
=> nrel_note:
	[в разделе «Космос» связки заданы для 5 пар объектов, например: галактика Андромеды — Андромеда] (* <- lang_ru;; *);;

nrel_mass
<- concept_wit_entity;
=> nrel_definition:
	[бинарное ориентированное отношение, связывающее космический объект со значением его массы, выраженным в килограммах или в массах Земли] (* <- lang_ru;; *);
=> nrel_note:
	[в разделе «Космос» связки заданы для 7 пар объектов, например: Луна — 7,35·10^22 кг] (* <- lang_ru;; *);;

nrel_mission_crew
<- concept_wit_entity;
=> nrel_definition:
	[бинарное ориентированное отношение, связывающее космическую миссию с космонавтом, входившим в состав её экипажа] (* <- lang_ru;; *);
=> nrel_note:
	[в разделе «Космос» связки заданы для 3 пар объектов, например: Восток-1 — Юрий Гагарин] (* <- lang_ru;; *);;

nrel_mission_target
<- concept_wit_entity;
=> nrel_definition:
	[бинарное ориентированное отношение, связывающее космическую миссию с описанием задачи, ради решения которой она была организована] (* <- lang_ru;; *);
=> nrel_note:
	[в разделе «Космос» связки заданы для 4 пар объектов, например: Восток-1 — выполнить первый в истории пилотируемый орбитальный полёт вокруг Земли и…] (* <- lang_ru;; *);;

nrel_natural_satellite
<- concept_wit_entity;
=> nrel_definition:
	[бинарное ориентированное отношение, связывающее небесное тело с телом естественного происхождения, обращающимся вокруг него] (* <- lang_ru;; *);
=> nrel_note:
	[в разделе «Космос» связки заданы для 3 пар объектов, например: Земля — Луна] (* <- lang_ru;; *);;

nrel_operator
<- concept_wit_entity;
=> nrel_definition:
	[бинарное ориентированное отношение, связывающее искусственный космический объект с космическим агентством, которое им управляет либо его эксплуатирует] (* <- lang_ru;; *);
=> nrel_note:
	[в разделе «Космос» связки заданы для 11 пар объектов, например: Спутник-1 — Роскосмос] (* <- lang_ru;; *);;

nrel_orbit
<- concept_wit_entity;
=> nrel_definition:
	[бинарное ориентированное отношение, связывающее космический объект с тем космическим объектом, вокруг центра масс которого он движется по орбите под действием силы тяготения] (* <- lang_ru;; *);
=> nrel_note:
	[в разделе «Космос» связки заданы для 15 пар объектов, например: Спутник-1 — Земля] (* <- lang_ru;; *);;

nrel_orbital_period
<- concept_wit_entity;
=> nrel_definition:
	[бинарное ориентированное отношение, связывающее космический объект со значением промежутка времени, за который он совершает один полный оборот вокруг другого объекта] (* <- lang_ru;; *);
=> nrel_note:
	[в разделе «Космос» связки заданы для 6 пар объектов, например: Луна — 27,32 суток] (* <- lang_ru;; *);;

nrel_spectral_class
<- concept_wit_entity;
=> nrel_definition:
	[бинарное ориентированное отношение, связывающее звезду с обозначением её класса в спектральной классификации, определяемого температурой её поверхности] (* <- lang_ru;; *);
=> nrel_note:
	[в разделе «Космос» связки заданы для 2 пар объектов, например: Солнце — G2V] (* <- lang_ru;; *);;

nrel_start_date
<- concept_wit_entity;
=> nrel_definition:
	[бинарное ориентированное отношение, связывающее космическую миссию с датой её начала, то есть датой старта] (* <- lang_ru;; *);
=> nrel_note:
	[в разделе «Космос» связки заданы для 4 пар объектов, например: Восток-1 — 12 апреля 1961 года] (* <- lang_ru;; *);;

nrel_used_launch_vehicle
<- concept_wit_entity;
=> nrel_definition:
	[бинарное ориентированное отношение, связывающее космическую миссию с той ракетой-носителем, которая использовалась для выведения её полезной нагрузки в космическое пространство] (* <- lang_ru;; *);
=> nrel_note:
	[в разделе «Космос» связки заданы для 4 пар объектов, например: Восток-1 — ракета-носитель Восток] (* <- lang_ru;; *);;

rrel_crew_commander
<- concept_wit_entity;
=> nrel_definition:
	[ролевое отношение, выделяющее в составе экипажа космической миссии того космонавта, который руководит полётом и несёт ответственность за выполнение программы миссии] (* <- lang_ru;; *);
=> nrel_note:
	[в разделе «Космос» связки заданы для 3 пар объектов, например: Восток-1 — Юрий Гагарин] (* <- lang_ru;; *);;
