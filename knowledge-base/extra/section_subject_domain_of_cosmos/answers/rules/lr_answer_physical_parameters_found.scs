/* Правило ответа на сообщение о физических характеристиках космического объекта: сведения есть в базе знаний.
   Если: у объекта есть масса* ИЛИ экваториальный радиус* ИЛИ спектральный класс* (дизъюнкция).
   Автор: Пикта И. */

@if_lr_answer_physical_parameters_found_1 = [*
	concept_message _-> _message;;
	concept_message_about_physical_parameters _-> _message;;
	_message _-> rrel_entity:: _entity;;
	_entity _=> nrel_mass:: _space_mass;;
*];;
@if_lr_answer_physical_parameters_found_2 = [*
	concept_message _-> _message;;
	concept_message_about_physical_parameters _-> _message;;
	_message _-> rrel_entity:: _entity;;
	_entity _=> nrel_equatorial_radius:: _space_radius;;
*];;
@if_lr_answer_physical_parameters_found_3 = [*
	concept_message _-> _message;;
	concept_message_about_physical_parameters _-> _message;;
	_message _-> rrel_entity:: _entity;;
	_entity _=> nrel_spectral_class:: _space_spectral_class;;
*];;
@or_lr_answer_physical_parameters_found = { @if_lr_answer_physical_parameters_found_1; @if_lr_answer_physical_parameters_found_2; @if_lr_answer_physical_parameters_found_3 };;
@or_lr_answer_physical_parameters_found <- nrel_disjunction;;
@then_lr_answer_physical_parameters_found = [*
	_message _=> nrel_reply:: _reply_message;;
	concept_atomic_message _-> _reply_message;;
	concept_message_about_physical_parameters _-> _reply_message;;
*];;
@if_lr_answer_physical_parameters_found_1 <- atomic_logical_formula;;
@if_lr_answer_physical_parameters_found_2 <- atomic_logical_formula;;
@if_lr_answer_physical_parameters_found_3 <- atomic_logical_formula;;
@then_lr_answer_physical_parameters_found <- atomic_logical_formula;;
@impl_lr_answer_physical_parameters_found = (@or_lr_answer_physical_parameters_found => @then_lr_answer_physical_parameters_found);;
@impl_lr_answer_physical_parameters_found <- nrel_implication;;
answer_pattern_lr_answer_physical_parameters_found
<- sc_node_tuple;
-> rrel_1: concept_phrase_about_physical_parameters_found;;
lr_answer_physical_parameters_found
<- concept_answer_on_standard_message_rule;
<- concept_answer_on_standard_message_rule_priority_2;
=> nrel_main_idtf:
	[правило ответа на сообщение о физических характеристиках космического объекта: сведения есть в базе знаний] (* <- lang_ru;; *);
	[rule of reply to a message about physical parameters of a space object: the data is in the knowledge base] (* <- lang_en;; *);
=> nrel_note:
	[если у объекта есть масса* ИЛИ экваториальный радиус* ИЛИ спектральный класс* (дизъюнкция); фразы ответа — из класса concept_phrase_about_physical_parameters_found] (* <- lang_ru;; *);
=> nrel_answer_pattern: answer_pattern_lr_answer_physical_parameters_found;
-> rrel_main_key_sc_element: @impl_lr_answer_physical_parameters_found;;
