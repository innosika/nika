/* Правило ответа на сообщение об открытии космического объекта: сведения есть в базе знаний.
   Если: у объекта есть связь «первооткрыватель*».
   Автор: Переверзев М. */

@if_lr_answer_discovery_found = [*
	concept_message _-> _message;;
	concept_message_about_discovery _-> _message;;
	_message _-> rrel_entity:: _entity;;
	_entity _=> nrel_discoverer:: _space_discoverer;;
*];;
@then_lr_answer_discovery_found = [*
	_message _=> nrel_reply:: _reply_message;;
	concept_atomic_message _-> _reply_message;;
	concept_message_about_discovery _-> _reply_message;;
*];;
@if_lr_answer_discovery_found <- atomic_logical_formula;;
@then_lr_answer_discovery_found <- atomic_logical_formula;;
@impl_lr_answer_discovery_found = (@if_lr_answer_discovery_found => @then_lr_answer_discovery_found);;
@impl_lr_answer_discovery_found <- nrel_implication;;
answer_pattern_lr_answer_discovery_found
<- sc_node_tuple;
-> rrel_1: concept_phrase_about_discovery_found;;
lr_answer_discovery_found
<- concept_answer_on_standard_message_rule;
<- concept_answer_on_standard_message_rule_priority_2;
=> nrel_main_idtf:
	[правило ответа на сообщение об открытии космического объекта: сведения есть в базе знаний] (* <- lang_ru;; *);
	[rule of reply to a message about a discovery of a space object: the data is in the knowledge base] (* <- lang_en;; *);
=> nrel_note:
	[если у объекта есть связь «первооткрыватель*»; фразы ответа — из класса concept_phrase_about_discovery_found] (* <- lang_ru;; *);
=> nrel_answer_pattern: answer_pattern_lr_answer_discovery_found;
-> rrel_main_key_sc_element: @impl_lr_answer_discovery_found;;
