/* Правило ответа на сообщение о спутниках небесного тела: звезда.
   Если: объект — звезда, вокруг которой обращаются другие тела (у звезды не спутники, а планетная система).
   Автор: Пикта И. */

@if_lr_answer_satellites_star = [*
	concept_message _-> _message;;
	concept_message_about_satellites _-> _message;;
	_message _-> rrel_entity:: _entity;;
	concept_star _-> _entity;;
	_space_orbiter _=> nrel_orbit:: _entity;;
*];;
@then_lr_answer_satellites_star = [*
	_message _=> nrel_reply:: _reply_message;;
	concept_atomic_message _-> _reply_message;;
	concept_message_about_satellites _-> _reply_message;;
*];;
@if_lr_answer_satellites_star <- atomic_logical_formula;;
@then_lr_answer_satellites_star <- atomic_logical_formula;;
@impl_lr_answer_satellites_star = (@if_lr_answer_satellites_star => @then_lr_answer_satellites_star);;
@impl_lr_answer_satellites_star <- nrel_implication;;
answer_pattern_lr_answer_satellites_star
<- sc_node_tuple;
-> rrel_1: concept_phrase_about_satellites_star;;
lr_answer_satellites_star
<- concept_answer_on_standard_message_rule;
<- concept_answer_on_standard_message_rule_priority_2;
=> nrel_main_idtf:
	[правило ответа на сообщение о спутниках небесного тела: звезда] (* <- lang_ru;; *);
	[rule of reply to a message about satellites of a celestial body: star] (* <- lang_en;; *);
=> nrel_note:
	[если объект — звезда, вокруг которой обращаются другие тела (у звезды не спутники, а планетная система); фразы ответа — из класса concept_phrase_about_satellites_star] (* <- lang_ru;; *);
=> nrel_answer_pattern: answer_pattern_lr_answer_satellites_star;
-> rrel_main_key_sc_element: @impl_lr_answer_satellites_star;;
