/* Правило ответа на сообщение о физических характеристиках космического объекта: вопрос о классе объектов.
   Если: выделенная сущность — класс, у экземпляра которого указана масса.
   Автор: Пикта И. */

@if_lr_answer_physical_parameters_for_group = [*
	concept_message _-> _message;;
	concept_message_about_physical_parameters _-> _message;;
	_message _-> rrel_entity:: _entity;;
	_entity _-> _instance;;
	_instance _=> nrel_mass:: _space_mass;;
*];;
@then_lr_answer_physical_parameters_for_group = [*
	_message _=> nrel_reply:: _reply_message;;
	concept_atomic_message _-> _reply_message;;
	concept_message_about_physical_parameters _-> _reply_message;;
*];;
@if_lr_answer_physical_parameters_for_group <- atomic_logical_formula;;
@then_lr_answer_physical_parameters_for_group <- atomic_logical_formula;;
@impl_lr_answer_physical_parameters_for_group = (@if_lr_answer_physical_parameters_for_group => @then_lr_answer_physical_parameters_for_group);;
@impl_lr_answer_physical_parameters_for_group <- nrel_implication;;
answer_pattern_lr_answer_physical_parameters_for_group
<- sc_node_tuple;
-> rrel_1: concept_phrase_about_physical_parameters_for_group;;
lr_answer_physical_parameters_for_group
<- concept_answer_on_standard_message_rule;
<- concept_answer_on_standard_message_rule_priority_2;
=> nrel_main_idtf:
	[правило ответа на сообщение о физических характеристиках космического объекта: вопрос о классе объектов] (* <- lang_ru;; *);
	[rule of reply to a message about physical parameters of a space object: question about a class of objects] (* <- lang_en;; *);
=> nrel_note:
	[если выделенная сущность — класс, у экземпляра которого указана масса; фразы ответа — из класса concept_phrase_about_physical_parameters_for_group] (* <- lang_ru;; *);
=> nrel_answer_pattern: answer_pattern_lr_answer_physical_parameters_for_group;
-> rrel_main_key_sc_element: @impl_lr_answer_physical_parameters_for_group;;
