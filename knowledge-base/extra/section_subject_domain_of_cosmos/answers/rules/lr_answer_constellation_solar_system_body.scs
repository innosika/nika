/* Правило ответа на сообщение о созвездии космического объекта: тело Солнечной системы.
   Если: объект обращается вокруг другого тела (тело Солнечной системы не принадлежит одному созвездию).
   Автор: Переверзев М. */

@if_lr_answer_constellation_solar_system_body = [*
	concept_message _-> _message;;
	concept_message_about_constellation _-> _message;;
	_message _-> rrel_entity:: _entity;;
	_entity _=> nrel_orbit:: _space_center;;
*];;
@then_lr_answer_constellation_solar_system_body = [*
	_message _=> nrel_reply:: _reply_message;;
	concept_atomic_message _-> _reply_message;;
	concept_message_about_constellation _-> _reply_message;;
*];;
@if_lr_answer_constellation_solar_system_body <- atomic_logical_formula;;
@then_lr_answer_constellation_solar_system_body <- atomic_logical_formula;;
@impl_lr_answer_constellation_solar_system_body = (@if_lr_answer_constellation_solar_system_body => @then_lr_answer_constellation_solar_system_body);;
@impl_lr_answer_constellation_solar_system_body <- nrel_implication;;
answer_pattern_lr_answer_constellation_solar_system_body
<- sc_node_tuple;
-> rrel_1: concept_phrase_about_constellation_solar_system_body;;
lr_answer_constellation_solar_system_body
<- concept_answer_on_standard_message_rule;
<- concept_answer_on_standard_message_rule_priority_2;
=> nrel_main_idtf:
	[правило ответа на сообщение о созвездии космического объекта: тело Солнечной системы] (* <- lang_ru;; *);
	[rule of reply to a message about a constellation of a space object: Solar System body] (* <- lang_en;; *);
=> nrel_note:
	[если объект обращается вокруг другого тела (тело Солнечной системы не принадлежит одному созвездию); фразы ответа — из класса concept_phrase_about_constellation_solar_system_body] (* <- lang_ru;; *);
=> nrel_answer_pattern: answer_pattern_lr_answer_constellation_solar_system_body;
-> rrel_main_key_sc_element: @impl_lr_answer_constellation_solar_system_body;;
