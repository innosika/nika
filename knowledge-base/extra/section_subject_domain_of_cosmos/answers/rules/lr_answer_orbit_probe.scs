/* Правило ответа на сообщение об орбите космического объекта: межпланетная станция.
   Если: объект — межпланетная станция (у неё нет орбиты вокруг тела: она уходит в дальний космос).
   Автор: Пикта И. */

@if_lr_answer_orbit_probe = [*
	concept_message _-> _message;;
	concept_message_about_orbit _-> _message;;
	_message _-> rrel_entity:: _entity;;
	concept_interplanetary_probe _-> _entity;;
*];;
@then_lr_answer_orbit_probe = [*
	_message _=> nrel_reply:: _reply_message;;
	concept_atomic_message _-> _reply_message;;
	concept_message_about_orbit _-> _reply_message;;
*];;
@if_lr_answer_orbit_probe <- atomic_logical_formula;;
@then_lr_answer_orbit_probe <- atomic_logical_formula;;
@impl_lr_answer_orbit_probe = (@if_lr_answer_orbit_probe => @then_lr_answer_orbit_probe);;
@impl_lr_answer_orbit_probe <- nrel_implication;;
answer_pattern_lr_answer_orbit_probe
<- sc_node_tuple;
-> rrel_1: concept_phrase_about_orbit_probe;;
lr_answer_orbit_probe
<- concept_answer_on_standard_message_rule;
<- concept_answer_on_standard_message_rule_priority_2;
=> nrel_main_idtf:
	[правило ответа на сообщение об орбите космического объекта: межпланетная станция] (* <- lang_ru;; *);
	[rule of reply to a message about an orbit of a space object: interplanetary probe] (* <- lang_en;; *);
=> nrel_note:
	[если объект — межпланетная станция (у неё нет орбиты вокруг тела: она уходит в дальний космос); фразы ответа — из класса concept_phrase_about_orbit_probe] (* <- lang_ru;; *);
=> nrel_answer_pattern: answer_pattern_lr_answer_orbit_probe;
-> rrel_main_key_sc_element: @impl_lr_answer_orbit_probe;;
