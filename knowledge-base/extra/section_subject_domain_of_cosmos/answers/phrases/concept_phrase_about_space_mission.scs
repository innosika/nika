/* Класс ответных фраз «фраза о космической миссии» (автор — Переверзев М.) и его подклассы по состоянию базы знаний.
   ${_x} — содержимое ссылки _x, $list{_x} — все различные значения _x через запятую. */

concept_phrase_about_space_mission
<- sc_node_class;
=> nrel_main_idtf:
	[фраза о космической миссии] (* <- lang_ru;; *);
	[phrase about a space mission] (* <- lang_en;; *);
<= nrel_inclusion:
	concept_phrase_about_space_exploration;
=> nrel_definition:
	[фраза, используемая при ответе на сообщение о космической миссии] (* <- lang_ru;; *);
=> nrel_note:
	[используется в ответах на сообщения класса concept_message_about_space_mission; автор — Переверзев М.] (* <- lang_ru;; *);;

concept_phrase_about_space_mission_apology
<- sc_node_class;
=> nrel_main_idtf:
	[фраза о космической миссии: извинение перед ответом на грубое сообщение] (* <- lang_ru;; *);
	[phrase about a space mission: apology before a reply to a rude message] (* <- lang_en;; *);
<= nrel_inclusion:
	concept_phrase_about_space_mission;
=> nrel_definition:
	[фраза для ответа, когда то же, что для правила «сведения есть», и сообщение имеет негативную эмоциональную окраску; ответ — составное сообщение: извинение, затем фраза со сведениями] (* <- lang_ru;; *);;

@phrase_space_mission_apology_1 = [Простите за задержку! Рассказываю о полёте.];;
@phrase_space_mission_apology_1
<- lang_ru;
<- concept_phrase_about_space_mission_apology;;

@phrase_space_mission_apology_2 = [Извините, что заставила ждать. Вот сведения о миссии.];;
@phrase_space_mission_apology_2
<- lang_ru;
<- concept_phrase_about_space_mission_apology;;

concept_phrase_about_space_mission_found
<- sc_node_class;
=> nrel_main_idtf:
	[фраза о космической миссии: сведения есть в базе знаний] (* <- lang_ru;; *);
	[phrase about a space mission: the data is in the knowledge base] (* <- lang_en;; *);
<= nrel_inclusion:
	concept_phrase_about_space_mission;
=> nrel_definition:
	[фраза для ответа, когда у объекта есть дата старта* (миссия) ИЛИ дата запуска* (космический аппарат) — дизъюнкция] (* <- lang_ru;; *);;

@template_space_mission_found_1 = [*
	concept_message _-> _message;;
	_message _-> rrel_entity:: _entity;;
	_entity _=> nrel_main_idtf:: _entity_name;;
	lang_ru _-> _entity_name;;
	_entity _=> nrel_start_date:: _space_start_date;;
	_entity _=> nrel_launch_site:: _space_launch_site;;
	_entity _=> nrel_used_launch_vehicle:: _space_launch_vehicle;;
*];;
@phrase_space_mission_found_1 = [Миссия «${_entity_name}» стартовала ${_space_start_date} с космодрома «$list{_space_launch_site}» на ракете-носителе «$list{_space_launch_vehicle}».];;
@phrase_space_mission_found_1
<- lang_ru;
<- concept_phrase_about_space_mission_found;
=> nrel_phrase_template: @template_space_mission_found_1;;

@template_space_mission_found_2 = [*
	concept_message _-> _message;;
	_message _-> rrel_entity:: _entity;;
	_entity _=> nrel_main_idtf:: _entity_name;;
	lang_ru _-> _entity_name;;
	_entity _=> nrel_start_date:: _space_start_date;;
	_entity _=> nrel_mission_target:: _space_target;;
*];;
@phrase_space_mission_found_2 = [Миссия «${_entity_name}» стартовала ${_space_start_date}. Её цель — ${_space_target}];;
@phrase_space_mission_found_2
<- lang_ru;
<- concept_phrase_about_space_mission_found;
=> nrel_phrase_template: @template_space_mission_found_2;;

