	_entity _=> nrel_main_idtf:: _entity_name;;
	lang_ru _-> _entity_name;;
	_entity _=> nrel_mission_crew:: _space_crew;;
	_entity _-> rrel_crew_commander:: _space_commander;;
	_entity _=> nrel_start_date:: _space_start_date;;
*];;
@phrase_space_mission_found_3 = [Экипаж миссии «${_entity_name}»: $list{_space_crew}; командир — $list{_space_commander}. Старт — ${_space_start_date}.];;
