/* Класс ответных фраз «фраза о спутниках небесного тела» (автор — Пикта И.) и его подклассы по состоянию базы знаний.
   ${_x} — содержимое ссылки _x, $list{_x} — все различные значения _x через запятую. */

concept_phrase_about_satellites
<- sc_node_class;
=> nrel_main_idtf:
	[фраза о спутниках небесного тела] (* <- lang_ru;; *);
	[phrase about satellites of a celestial body] (* <- lang_en;; *);
<= nrel_inclusion:
	concept_phrase_about_celestial_body_properties;
=> nrel_definition:
	[фраза, используемая при ответе на сообщение о спутниках небесного тела] (* <- lang_ru;; *);
=> nrel_note:
	[используется в ответах на сообщения класса concept_message_about_satellites; автор — Пикта И.] (* <- lang_ru;; *);;

concept_phrase_about_satellites_apology
<- sc_node_class;
=> nrel_main_idtf:
	[фраза о спутниках небесного тела: извинение перед ответом на грубое сообщение] (* <- lang_ru;; *);
	[phrase about satellites of a celestial body: apology before a reply to a rude message] (* <- lang_en;; *);
<= nrel_inclusion:
	concept_phrase_about_satellites;
=> nrel_definition:
	[фраза для ответа, когда то же, что для правила «сведения есть», и сообщение имеет негативную эмоциональную окраску; ответ — составное сообщение: извинение, затем фраза со сведениями] (* <- lang_ru;; *);;

@phrase_satellites_apology_1 = [Простите, что заставила ждать! Рассказываю о спутниках.];;
@phrase_satellites_apology_1
<- lang_ru;
<- concept_phrase_about_satellites_apology;;

@phrase_satellites_apology_2 = [Извините за задержку — вот что известно о спутниках.];;
@phrase_satellites_apology_2
<- lang_ru;
<- concept_phrase_about_satellites_apology;;

concept_phrase_about_satellites_found
<- sc_node_class;
=> nrel_main_idtf:
	[фраза о спутниках небесного тела: сведения есть в базе знаний] (* <- lang_ru;; *);
	[phrase about satellites of a celestial body: the data is in the knowledge base] (* <- lang_en;; *);
<= nrel_inclusion:
	concept_phrase_about_satellites;
=> nrel_definition:
	[фраза для ответа, когда у объекта есть связь «естественный спутник*»] (* <- lang_ru;; *);;

@template_satellites_found_1 = [*
	concept_message _-> _message;;
	_message _-> rrel_entity:: _entity;;
	_entity _=> nrel_main_idtf:: _entity_name;;
	lang_ru _-> _entity_name;;
	_entity _=> nrel_natural_satellite:: _space_satellite;;
*];;
@phrase_satellites_found_1 = [Естественные спутники объекта «${_entity_name}»: $list{_space_satellite}.];;
@phrase_satellites_found_1
<- lang_ru;
<- concept_phrase_about_satellites_found;
=> nrel_phrase_template: @template_satellites_found_1;;

@template_satellites_found_2 = [*
	concept_message _-> _message;;
	_message _-> rrel_entity:: _entity;;
	_entity _=> nrel_main_idtf:: _entity_name;;
	lang_ru _-> _entity_name;;
	_entity _=> nrel_natural_satellite:: _space_satellite;;
*];;
@phrase_satellites_found_2 = [У объекта «${_entity_name}» в базе знаний указаны естественные спутники: $list{_space_satellite}.];;
@phrase_satellites_found_2
<- lang_ru;
<- concept_phrase_about_satellites_found;
=> nrel_phrase_template: @template_satellites_found_2;;

@template_satellites_found_3 = [*
	concept_message _-> _message;;
	_message _-> rrel_entity:: _entity;;
	_entity _=> nrel_main_idtf:: _entity_name;;
	lang_ru _-> _entity_name;;
	_entity _=> nrel_natural_satellite:: _space_satellite;;
	_space_satellite _=> nrel_discoverer:: _space_satellite_discoverer;;
*];;
@phrase_satellites_found_3 = [Естественный спутник объекта «${_entity_name}» — $list{_space_satellite}; его открыл $list{_space_satellite_discoverer}.];;
@phrase_satellites_found_3
<- lang_ru;
<- concept_phrase_about_satellites_found;
=> nrel_phrase_template: @template_satellites_found_3;;

@template_satellites_found_4 = [*
	concept_message _-> _message;;
	_message _-> rrel_entity:: _entity;;
	_entity _=> nrel_main_idtf:: _entity_name;;
	lang_ru _-> _entity_name;;
	_entity _=> nrel_natural_satellite:: _space_satellite;;
	_space_satellite _=> nrel_orbital_period:: _space_satellite_period;;
*];;
@phrase_satellites_found_4 = [Спутник объекта «${_entity_name}» — $list{_space_satellite}; период его обращения — $list{_space_satellite_period}.];;
@phrase_satellites_found_4
<- lang_ru;
<- concept_phrase_about_satellites_found;
=> nrel_phrase_template: @template_satellites_found_4;;

concept_phrase_about_satellites_star
<- sc_node_class;
=> nrel_main_idtf:
	[фраза о спутниках небесного тела: звезда] (* <- lang_ru;; *);
	[phrase about satellites of a celestial body: star] (* <- lang_en;; *);
<= nrel_inclusion:
	concept_phrase_about_satellites;
=> nrel_definition:
	[фраза для ответа, когда объект — звезда, вокруг которой обращаются другие тела (у звезды не спутники, а планетная система)] (* <- lang_ru;; *);;

@template_satellites_star_1 = [*
	concept_message _-> _message;;
	_message _-> rrel_entity:: _entity;;
	_entity _=> nrel_main_idtf:: _entity_name;;
	lang_ru _-> _entity_name;;
	concept_star _-> _entity;;
	_space_orbiter _=> nrel_orbit:: _entity;;
*];;
@phrase_satellites_star_1 = [У звезды «${_entity_name}» нет спутников в обычном смысле: вокруг неё обращаются планеты и малые тела — $list{_space_orbiter}.];;
@phrase_satellites_star_1
<- lang_ru;
<- concept_phrase_about_satellites_star;
=> nrel_phrase_template: @template_satellites_star_1;;

@template_satellites_star_2 = [*
	concept_message _-> _message;;
	_message _-> rrel_entity:: _entity;;
	_entity _=> nrel_main_idtf:: _entity_name;;
	lang_ru _-> _entity_name;;
	concept_star _-> _entity;;
	_space_orbiter _=> nrel_orbit:: _entity;;
*];;
@phrase_satellites_star_2 = [Звезда «${_entity_name}» — центр планетной системы; вокруг неё обращаются: $list{_space_orbiter}.];;
@phrase_satellites_star_2
<- lang_ru;
<- concept_phrase_about_satellites_star;
=> nrel_phrase_template: @template_satellites_star_2;;

concept_phrase_about_satellites_for_group
<- sc_node_class;
=> nrel_main_idtf:
	[фраза о спутниках небесного тела: вопрос о классе объектов] (* <- lang_ru;; *);
	[phrase about satellites of a celestial body: question about a class of objects] (* <- lang_en;; *);
<= nrel_inclusion:
	concept_phrase_about_satellites;
=> nrel_definition:
	[фраза для ответа, когда выделенная сущность — класс, у экземпляра которого есть естественные спутники] (* <- lang_ru;; *);;

@template_satellites_for_group_1 = [*
	concept_message _-> _message;;
	_message _-> rrel_entity:: _entity;;
	_entity _=> nrel_main_idtf:: _entity_name;;
	lang_ru _-> _entity_name;;
	_entity _-> _instance;;
	_instance _=> nrel_natural_satellite:: _space_satellite;;
*];;
@phrase_satellites_for_group_1 = [У объектов класса «${_entity_name}» ($list{_instance}) есть естественные спутники: $list{_space_satellite}.];;
@phrase_satellites_for_group_1
<- lang_ru;
<- concept_phrase_about_satellites_for_group;
=> nrel_phrase_template: @template_satellites_for_group_1;;

@template_satellites_for_group_2 = [*
	concept_message _-> _message;;
	_message _-> rrel_entity:: _entity;;
	_entity _=> nrel_main_idtf:: _entity_name;;
	lang_ru _-> _entity_name;;
	_entity _-> _instance;;
	_instance _=> nrel_natural_satellite:: _space_satellite;;
*];;
@phrase_satellites_for_group_2 = [Спутники зависят от объекта класса «${_entity_name}»; в базе знаний указаны: $list{_space_satellite}. Уточните объект: $list{_instance}.];;
@phrase_satellites_for_group_2
<- lang_ru;
<- concept_phrase_about_satellites_for_group;
=> nrel_phrase_template: @template_satellites_for_group_2;;

