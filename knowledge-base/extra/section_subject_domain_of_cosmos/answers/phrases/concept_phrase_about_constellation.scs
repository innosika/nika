	[phrase about a constellation of a space object: no data in the knowledge base] (* <- lang_en;; *);
<= nrel_inclusion:
	concept_phrase_about_constellation;
=> nrel_definition:
	[фраза для ответа, когда сообщение о созвездии с выделенной сущностью, для которой не сработали правила с более высоким приоритетом] (* <- lang_ru;; *);;

@template_constellation_not_found_1 = [*
	concept_message _-> _message;;
	_message _-> rrel_entity:: _entity;;
	_entity _=> nrel_main_idtf:: _entity_name;;
