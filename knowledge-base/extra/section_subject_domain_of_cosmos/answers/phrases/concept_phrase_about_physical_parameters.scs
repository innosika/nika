concept_phrase_about_physical_parameters_for_group
<- sc_node_class;
=> nrel_main_idtf:
	[фраза о физических характеристиках космического объекта: вопрос о классе объектов] (* <- lang_ru;; *);
	[phrase about physical parameters of a space object: question about a class of objects] (* <- lang_en;; *);
<= nrel_inclusion:
	concept_phrase_about_physical_parameters;
=> nrel_definition:
	[фраза для ответа, когда выделенная сущность — класс, у экземпляра которого указана масса] (* <- lang_ru;; *);;

@template_physical_parameters_for_group_1 = [*
	concept_message _-> _message;;
	_message _-> rrel_entity:: _entity;;
	_entity _=> nrel_main_idtf:: _entity_name;;
	lang_ru _-> _entity_name;;
	_entity _-> _instance;;
	_instance _=> nrel_mass:: _space_mass;;
*];;
@phrase_physical_parameters_for_group_1 = [В классе «${_entity_name}» масса указана для объектов: $list{_instance}. Назовите конкретный объект — я приведу его характеристики.];;
@phrase_physical_parameters_for_group_1
<- lang_ru;
<- concept_phrase_about_physical_parameters_for_group;
=> nrel_phrase_template: @template_physical_parameters_for_group_1;;

@template_physical_parameters_for_group_2 = [*
	concept_message _-> _message;;
	_message _-> rrel_entity:: _entity;;
	_entity _=> nrel_main_idtf:: _entity_name;;
	lang_ru _-> _entity_name;;
	_entity _-> _instance;;
	_instance _=> nrel_mass:: _space_mass;;
*];;
@phrase_physical_parameters_for_group_2 = [Характеристики зависят от конкретного объекта класса «${_entity_name}»; в базе знаний есть данные о массе объектов: $list{_instance}.];;
@phrase_physical_parameters_for_group_2
<- lang_ru;
<- concept_phrase_about_physical_parameters_for_group;
=> nrel_phrase_template: @template_physical_parameters_for_group_2;;

concept_phrase_about_physical_parameters_not_found
<- sc_node_class;
=> nrel_main_idtf:
	[фраза о физических характеристиках космического объекта: сведений нет в базе знаний] (* <- lang_ru;; *);
	[phrase about physical parameters of a space object: no data in the knowledge base] (* <- lang_en;; *);
<= nrel_inclusion:
	concept_phrase_about_physical_parameters;
=> nrel_definition:
	[фраза для ответа, когда сообщение о физических характеристиках с выделенной сущностью, для которой не сработали правила с более высоким приоритетом] (* <- lang_ru;; *);;

@template_physical_parameters_not_found_1 = [*
	concept_message _-> _message;;
	_message _-> rrel_entity:: _entity;;
	_entity _=> nrel_main_idtf:: _entity_name;;
	lang_ru _-> _entity_name;;
*];;
@phrase_physical_parameters_not_found_1 = [Физические характеристики объекта «${_entity_name}» в базе знаний не указаны.];;
@phrase_physical_parameters_not_found_1
<- lang_ru;
<- concept_phrase_about_physical_parameters_not_found;
=> nrel_phrase_template: @template_physical_parameters_not_found_1;;

@template_physical_parameters_not_found_2 = [*
	concept_message _-> _message;;
	_message _-> rrel_entity:: _entity;;
	_entity _=> nrel_main_idtf:: _entity_name;;
	lang_ru _-> _entity_name;;
*];;
@phrase_physical_parameters_not_found_2 = [Масса и размеры объекта «${_entity_name}» в моей базе знаний не указаны.];;
@phrase_physical_parameters_not_found_2
<- lang_ru;
<- concept_phrase_about_physical_parameters_not_found;
=> nrel_phrase_template: @template_physical_parameters_not_found_2;;
