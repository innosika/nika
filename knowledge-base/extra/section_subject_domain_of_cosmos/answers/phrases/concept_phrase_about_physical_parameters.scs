	_entity _=> nrel_main_idtf:: _entity_name;;
	lang_ru _-> _entity_name;;
	_entity _=> nrel_mass:: _space_mass;;
	_entity _=> nrel_equatorial_radius:: _space_radius;;
*];;
@phrase_physical_parameters_found_3 = [Физические характеристики объекта «${_entity_name}»: масса — ${_space_mass}, экваториальный радиус — ${_space_radius}.];;
@phrase_physical_parameters_found_3
<- lang_ru;
<- concept_phrase_about_physical_parameters_found;
