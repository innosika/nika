concept_space_agency
<- sc_node_class;
<- class;
<- concept_wit_entity;
=> nrel_main_idtf:
    [космическое агентство]
    (* <- lang_ru;; *);
    [space agency]
    (* <- lang_en;; *);
=> nrel_definition:
    [государственная или межгосударственная организация, отвечающая
    за разработку, запуск и эксплуатацию космической техники и за проведение космических
    исследований]
    (* <- lang_ru;; *);;
