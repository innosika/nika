concept_cosmonaut
<- sc_node_class;
<- class;
<- concept_wit_entity;
=> nrel_main_idtf:
    [космонавт]
    (* <- lang_ru;; *);
    [cosmonaut]
    (* <- lang_en;; *);
=> nrel_definition:
    [человек, прошедший специальную подготовку и совершивший полёт в космическое
    пространство в качестве члена экипажа космического аппарата. В США и ряде других стран
    используется термин "астронавт"]
    (* <- lang_ru;; *);;
