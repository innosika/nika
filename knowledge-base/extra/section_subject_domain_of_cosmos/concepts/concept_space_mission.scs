concept_space_mission
<- sc_node_class;
<- class;
<- concept_wit_entity;
=> nrel_main_idtf:
    [космическая миссия]
    (* <- lang_ru;; *);
    [space mission]
    (* <- lang_en;; *);
=> nrel_definition:
    [космический полёт, организованный для достижения заранее
    поставленной цели: вывода аппарата на орбиту, исследования небесного тела,
    доставки экипажа или груза]
    (* <- lang_ru;; *);;
