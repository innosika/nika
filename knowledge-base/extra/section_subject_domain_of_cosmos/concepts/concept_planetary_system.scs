concept_planetary_system
<- sc_node_class;
<- class;
<- concept_wit_entity;
=> nrel_main_idtf:
    [планетная система]
    (* <- lang_ru;; *);
    [planetary system]
    (* <- lang_en;; *);
=> nrel_definition:
    [система, состоящая из звезды и обращающихся вокруг неё планет,
    карликовых планет, спутников, малых тел и межпланетной среды. Планетная система,
    в которую входит Земля, называется Солнечной системой]
    (* <- lang_ru;; *);;
