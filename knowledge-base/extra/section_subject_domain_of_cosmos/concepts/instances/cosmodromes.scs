/* Экземпляры класса "космодром". */
baikonur
<- concept_cosmodrome;
<- concept_wit_entity;
=> nrel_main_idtf:
    [Байконур]
    (* <- lang_ru;; *);
    [Baikonur]
    (* <- lang_en;; *);
=> nrel_definition:
    [первый и крупнейший в мире космодром, расположенный на территории Казахстана
    и арендуемый Россией. С него был выполнен запуск первого искусственного спутника Земли
    и первый полёт человека в космос]
    (* <- lang_ru;; *);;


cape_canaveral
<- concept_cosmodrome;
<- concept_wit_entity;
=> nrel_main_idtf:
    [Мыс Канаверал]
    (* <- lang_ru;; *);
    [Cape Canaveral]
    (* <- lang_en;; *);
=> nrel_definition:
    [космодром на восточном побережье Флориды, основная стартовая площадка
    США, с которой стартовали миссии программ "Аполлон" и "Спейс шаттл"]
    (* <- lang_ru;; *);;


vostochny
<- concept_cosmodrome;
<- concept_wit_entity;
=> nrel_main_idtf:
    [Восточный]
    (* <- lang_ru;; *);
    [Vostochny]
    (* <- lang_en;; *);
=> nrel_definition:
    [российский космодром в Амурской области, строительство которого начато
    в 2012 году с целью обеспечить независимый доступ России в космос с собственной территории]
    (* <- lang_ru;; *);;
