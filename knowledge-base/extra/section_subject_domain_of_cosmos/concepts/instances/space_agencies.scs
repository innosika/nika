/* Экземпляры класса "космическое агентство". */
roscosmos
<- concept_space_agency;
<- concept_wit_entity;
=> nrel_main_idtf:
    [Роскосмос]
    (* <- lang_ru;; *);
    [Roscosmos]
    (* <- lang_en;; *);
=> nrel_definition:
    [российская государственная корпорация, отвечающая за космическую
    деятельность Российской Федерации, включая пилотируемые полёты и научные программы]
    (* <- lang_ru;; *);;


nasa
<- concept_space_agency;
<- concept_wit_entity;
=> nrel_main_idtf:
    [НАСА]
    (* <- lang_ru;; *);
    [NASA]
    (* <- lang_en;; *);
=> nrel_definition:
    [Национальное управление по аэронавтике и исследованию космического пространства,
    ведомство США, отвечающее за гражданскую космическую программу и аэрокосмические
    исследования]
    (* <- lang_ru;; *);;


esa
<- concept_space_agency;
<- concept_wit_entity;
=> nrel_main_idtf:
    [Европейское космическое агентство]
    (* <- lang_ru;; *);
    [European Space Agency]
    (* <- lang_en;; *);
=> nrel_definition:
    [межправительственная организация, объединяющая
    ресурсы европейских стран для реализации совместных космических программ]
    (* <- lang_ru;; *);;
