/* Экземпляр класса "планетная система". */
solar_system
<- concept_planetary_system;
<- concept_wit_entity;
=> nrel_main_idtf:
    [Солнечная система]
    (* <- lang_ru;; *);
    [Solar System]
    (* <- lang_en;; *);
=> nrel_definition:
    [планетная система, включающая центральную звезду Солнце и все
    естественные космические объекты, обращающиеся вокруг неё: восемь планет с их спутниками,
    карликовые планеты, астероиды, кометы и межпланетную среду]
    (* <- lang_ru;; *);
/* Разбиение Солнечной системы по видам входящих в неё тел */
<= nrel_subdividing:
    ...
    (*
        <- sc_node_tuple;;
        -> sun;;
        -> earth;;
        -> mars;;
        -> jupiter;;
        -> saturn;;
        -> pluto;;
        -> ceres;;
        -> vesta;;
        -> halley_comet;;
    *);;
