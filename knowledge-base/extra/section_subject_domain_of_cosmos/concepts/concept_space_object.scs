/* Максимальный класс объектов исследования предметной области.
   Максимальный - значит, что в рамках этой ПрО у него нет надкласса,
   который тоже был бы классом объектов исследования. */
concept_space_object
<- sc_node_class;
<- class;
<- concept_wit_entity;
=> nrel_main_idtf:
    [космический объект]
    (* <- lang_ru;; *);
    [space object]
    (* <- lang_en;; *);
=> nrel_definition:
    [материальное тело или система тел естественного либо искусственного
    происхождения, находящиеся в космическом пространстве за пределами плотных слоёв атмосферы Земли]
    (* <- lang_ru;; *);
/* Разбиение (декомпозиция) класса по признаку происхождения.
   Именно на nrel_subdividing опирается вопрос "Каким бывает ...?". */
<= nrel_subdividing:
    ...
    (*
        <- sc_node_tuple;;
        -> concept_natural_space_object;;
        -> concept_artificial_space_object;;
    *);;
