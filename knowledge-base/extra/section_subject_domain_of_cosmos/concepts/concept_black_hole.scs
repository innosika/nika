concept_black_hole
<- sc_node_class;
<- class;
<- concept_wit_entity;
=> nrel_main_idtf:
    [чёрная дыра]
    (* <- lang_ru;; *);
    [black hole]
    (* <- lang_en;; *);
=> nrel_definition:
    [область пространства-времени, гравитационное притяжение которой настолько
    велико, что покинуть её не могут даже объекты, движущиеся со скоростью света. Границей
    области является горизонт событий]
    (* <- lang_ru;; *);
<= nrel_inclusion:
    concept_natural_space_object;;
