concept_star
<- sc_node_class;
<- class;
<- concept_wit_entity;
=> nrel_main_idtf:
    [звезда]
    (* <- lang_ru;; *);
    [star]
    (* <- lang_en;; *);
=> nrel_definition:
    [массивный самосветящийся газовый шар, в недрах которого идут (или шли ранее)
    термоядерные реакции синтеза гелия из водорода; удерживается в равновесии собственной
    гравитацией и внутренним давлением]
    (* <- lang_ru;; *);
=> nrel_note:
    [Звёзды классифицируют по спектральным классам O, B, A, F, G, K, M - от самых горячих
    к самым холодным. Солнце относится к спектральному классу G2V.]
    (* <- lang_ru;; *);
<= nrel_inclusion:
    concept_natural_space_object;;
