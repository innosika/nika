concept_constellation
<- sc_node_class;
<- class;
<- concept_wit_entity;
=> nrel_main_idtf:
    [созвездие]
    (* <- lang_ru;; *);
    [constellation]
    (* <- lang_en;; *);
=> nrel_definition:
    [участок небесной сферы с чётко очерченными границами, объединяющий все
    находящиеся в его пределах светила. С 1922 года Международный астрономический союз
    выделяет 88 созвездий, покрывающих всю небесную сферу]
    (* <- lang_ru;; *);
=> nrel_note:
    [Важно: созвездие не является космическим объектом - это область неба, а не тело.
    Поэтому в данной предметной области оно описано как отдельный (немаксимальный)
    класс объектов исследования, не включённый в класс "космический объект".]
    (* <- lang_ru;; *);;
