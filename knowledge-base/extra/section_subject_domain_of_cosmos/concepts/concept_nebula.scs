concept_nebula
<- sc_node_class;
<- class;
<- concept_wit_entity;
=> nrel_main_idtf:
    [туманность]
    (* <- lang_ru;; *);
    [nebula]
    (* <- lang_en;; *);
=> nrel_definition:
    [участок межзвёздной среды, выделяющийся своим излучением или поглощением
    на общем фоне неба. Различают эмиссионные, отражательные, тёмные и планетарные туманности]
    (* <- lang_ru;; *);
<= nrel_inclusion:
    concept_natural_space_object;;
