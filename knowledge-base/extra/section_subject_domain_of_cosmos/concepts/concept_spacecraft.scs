concept_spacecraft
<- sc_node_class;
<- class;
<- concept_wit_entity;
=> nrel_main_idtf:
    [космический аппарат]
    (* <- lang_ru;; *);
    [spacecraft]
    (* <- lang_en;; *);
=> nrel_definition:
    [техническое устройство, предназначенное для выполнения задач
    в космическом пространстве: исследования, связи, навигации, наблюдения Земли или
    доставки экипажа и грузов]
    (* <- lang_ru;; *);
<= nrel_inclusion:
    concept_artificial_space_object;
<= nrel_subdividing:
    ...
    (*
        <- sc_node_tuple;;
        -> concept_artificial_satellite;;
        -> concept_space_station;;
        -> concept_interplanetary_probe;;
    *);;
