concept_message_about_space_knowledge
<- sc_node_class;
=> nrel_main_idtf:
	[сообщение о знаниях о космосе из внешних источников] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[message about space knowledge from external sources] (* <- lang_en;; *);
