nrel_planetary_system
<- sc_node_non_role_relation;
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
=> nrel_main_idtf:
	[входит в планетную систему*] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[member of planetary system*] (* <- lang_en;; *);
=> nrel_first_domain:
	concept_space_object;
=> nrel_second_domain:
	concept_planetary_system;
=> nrel_definition:
	[бинарное ориентированное отношение, связывающее небесное тело с планетной системой, в которую оно входит (выводится правилами)] (* <- lang_ru;; *);;
