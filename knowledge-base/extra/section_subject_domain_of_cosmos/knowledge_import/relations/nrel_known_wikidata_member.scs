nrel_known_wikidata_member
<- sc_node_non_role_relation;
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
=> nrel_main_idtf:
	[известный объект класса в Wikidata*] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[known Wikidata member*] (* <- lang_en;; *);
=> nrel_first_domain:
	concept_wikidata_class;
=> nrel_second_domain:
	file;
=> nrel_definition:
	[бинарное ориентированное отношение, связывающее класс Wikidata с идентификатором его известного объекта — для классов, запрос самых известных объектов которых не укладывается в отведённое время (звёзды)] (* <- lang_ru;; *);;
