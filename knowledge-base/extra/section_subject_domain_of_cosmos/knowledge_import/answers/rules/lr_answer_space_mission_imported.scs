/* Правило ответа на сообщение (космическая миссия): сведения только что загружены из Wikidata. Автор: Пикта И. Д.. */

@if_lr_answer_space_mission_imported = [*
	concept_message _-> _message;;
	_message _=> nrel_space_import_report:: _space_report;;
	_message _-> rrel_entity:: _entity;;
	_entity _=> nrel_start_date:: _space_value;;
	concept_message_about_space_mission _-> _message;;
*];;
@then_lr_answer_space_mission_imported = [*
	_message _=> nrel_reply:: _reply_message;;
	concept_non_atomic_message _-> _reply_message;;
	_reply_decomposition _=> nrel_message_decomposition:: _reply_message;;
	@reply_part_arc_1_lr_answer_space_mission_imported = (_reply_decomposition _-> _reply_part_1);;
	rrel_1 _-> @reply_part_arc_1_lr_answer_space_mission_imported;;
	@reply_part_arc_2_lr_answer_space_mission_imported = (_reply_decomposition _-> _reply_part_2);;
	@reply_parts_order_lr_answer_space_mission_imported = (@reply_part_arc_1_lr_answer_space_mission_imported _=> @reply_part_arc_2_lr_answer_space_mission_imported);;
	nrel_message_sequence _-> @reply_parts_order_lr_answer_space_mission_imported;;
	concept_atomic_message _-> _reply_part_1;;
	concept_atomic_message _-> _reply_part_2;;
*];;
@if_lr_answer_space_mission_imported <- atomic_logical_formula;;
@then_lr_answer_space_mission_imported <- atomic_logical_formula;;
_reply_decomposition <- sc_node_tuple;;
@impl_lr_answer_space_mission_imported = (@if_lr_answer_space_mission_imported => @then_lr_answer_space_mission_imported);;
@impl_lr_answer_space_mission_imported <- nrel_implication;;
answer_pattern_lr_answer_space_mission_imported
<- sc_node_tuple;;
@pattern_arc_1_lr_answer_space_mission_imported = (answer_pattern_lr_answer_space_mission_imported -> concept_phrase_about_space_import_notice_space_mission);;
rrel_1 -> @pattern_arc_1_lr_answer_space_mission_imported;;
@pattern_arc_2_lr_answer_space_mission_imported = (answer_pattern_lr_answer_space_mission_imported -> concept_phrase_about_space_mission_found);;
@pattern_order_lr_answer_space_mission_imported = (@pattern_arc_1_lr_answer_space_mission_imported => @pattern_arc_2_lr_answer_space_mission_imported);;
nrel_basic_sequence -> @pattern_order_lr_answer_space_mission_imported;;
lr_answer_space_mission_imported
<- concept_answer_on_standard_message_rule;
<- concept_answer_on_standard_message_rule_priority_1;
=> nrel_main_idtf:
	[правило ответа на сообщение (космическая миссия): сведения только что загружены из Wikidata] (* <- lang_ru;; *);
=> nrel_answer_pattern: answer_pattern_lr_answer_space_mission_imported;
-> rrel_main_key_sc_element: @impl_lr_answer_space_mission_imported;;
