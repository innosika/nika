/* Правило ответа на сообщение об объектах класса: сведения есть. Автор: бригада. */

@if_lr_answer_space_class_members_found = [*
	concept_message _-> _message;;
	_message _-> rrel_entity:: _entity;;
	_entity _-> _space_member;;
	concept_wit_entity _-> _space_member;;
	concept_message_about_space_class_members _-> _message;;
*];;
@then_lr_answer_space_class_members_found = [*
	_message _=> nrel_reply:: _reply_message;;
	concept_atomic_message _-> _reply_message;;
*];;
@if_lr_answer_space_class_members_found <- atomic_logical_formula;;
@then_lr_answer_space_class_members_found <- atomic_logical_formula;;
@impl_lr_answer_space_class_members_found = (@if_lr_answer_space_class_members_found => @then_lr_answer_space_class_members_found);;
@impl_lr_answer_space_class_members_found <- nrel_implication;;
answer_pattern_lr_answer_space_class_members_found
<- sc_node_tuple;
-> rrel_1: concept_phrase_about_space_class_members_found;;
lr_answer_space_class_members_found
<- concept_answer_on_standard_message_rule;
<- concept_answer_on_standard_message_rule_priority_2;
=> nrel_main_idtf:
	[правило ответа на сообщение об объектах класса: сведения есть] (* <- lang_ru;; *);
=> nrel_answer_pattern: answer_pattern_lr_answer_space_class_members_found;
-> rrel_main_key_sc_element: @impl_lr_answer_space_class_members_found;;
