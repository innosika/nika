/* Правило ответа на сообщение о телах планетной системы: сведения есть. Автор: бригада. */

@if_lr_answer_planetary_system_bodies_found = [*
	concept_message _-> _message;;
	_message _-> rrel_entity:: _entity;;
	_space_body _=> nrel_planetary_system:: _entity;;
	concept_message_about_planetary_system_bodies _-> _message;;
*];;
@then_lr_answer_planetary_system_bodies_found = [*
	_message _=> nrel_reply:: _reply_message;;
	concept_atomic_message _-> _reply_message;;
*];;
@if_lr_answer_planetary_system_bodies_found <- atomic_logical_formula;;
@then_lr_answer_planetary_system_bodies_found <- atomic_logical_formula;;
@impl_lr_answer_planetary_system_bodies_found = (@if_lr_answer_planetary_system_bodies_found => @then_lr_answer_planetary_system_bodies_found);;
@impl_lr_answer_planetary_system_bodies_found <- nrel_implication;;
answer_pattern_lr_answer_planetary_system_bodies_found
<- sc_node_tuple;
-> rrel_1: concept_phrase_about_planetary_system_bodies_found;;
lr_answer_planetary_system_bodies_found
<- concept_answer_on_standard_message_rule;
<- concept_answer_on_standard_message_rule_priority_2;
=> nrel_main_idtf:
	[правило ответа на сообщение о телах планетной системы: сведения есть] (* <- lang_ru;; *);
=> nrel_answer_pattern: answer_pattern_lr_answer_planetary_system_bodies_found;
-> rrel_main_key_sc_element: @impl_lr_answer_planetary_system_bodies_found;;
