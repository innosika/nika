concept_phrase_about_space_filling_report
<- sc_node_class;
=> nrel_main_idtf:
	[фраза о наполнении базы знаний космическими объектами: отчёт без новых объектов] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[phrase about space KB filling: report] (* <- lang_en;; *);
<= nrel_inclusion:
	concept_phrase_about_space_knowledge;;

@template_phrase_about_space_filling_report_1 = [*
	concept_message _-> _message;;
	_message _=> nrel_space_import_report:: _space_report;;
*];;
@phrase_about_space_filling_report_1 = [${_space_report}];;
@phrase_about_space_filling_report_1
<- lang_ru;
<- concept_phrase_about_space_filling_report;
=> nrel_phrase_template: @template_phrase_about_space_filling_report_1;;
