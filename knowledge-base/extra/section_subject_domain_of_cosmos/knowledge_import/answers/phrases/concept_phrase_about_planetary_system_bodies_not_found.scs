concept_phrase_about_planetary_system_bodies_not_found
<- sc_node_class;
=> nrel_main_idtf:
	[фраза о телах планетной системы: сведений нет] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[phrase about planetary system bodies: not found] (* <- lang_en;; *);
<= nrel_inclusion:
	concept_phrase_about_space_knowledge;;

@template_phrase_about_planetary_system_bodies_not_found_1 = [*
	concept_message _-> _message;;
	_message _-> rrel_entity:: _entity;;
	_entity _=> nrel_main_idtf:: _entity_name;;
	lang_ru _-> _entity_name;;
*];;
@phrase_about_planetary_system_bodies_not_found_1 = [Пока я не знаю, какие тела входят в систему «${_entity_name}». Попросите меня наполнить базу знаний небесными телами из Wikidata — я выведу это сама.];;
@phrase_about_planetary_system_bodies_not_found_1
<- lang_ru;
<- concept_phrase_about_planetary_system_bodies_not_found;
=> nrel_phrase_template: @template_phrase_about_planetary_system_bodies_not_found_1;;
