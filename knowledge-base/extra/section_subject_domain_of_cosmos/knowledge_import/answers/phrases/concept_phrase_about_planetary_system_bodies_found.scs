concept_phrase_about_planetary_system_bodies_found
<- sc_node_class;
=> nrel_main_idtf:
	[фраза о телах планетной системы: сведения есть] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[phrase about planetary system bodies: found] (* <- lang_en;; *);
<= nrel_inclusion:
	concept_phrase_about_space_knowledge;;

@template_phrase_about_planetary_system_bodies_found_1 = [*
	concept_message _-> _message;;
	_message _-> rrel_entity:: _entity;;
	_entity _=> nrel_main_idtf:: _entity_name;;
	lang_ru _-> _entity_name;;
	_space_body _=> nrel_planetary_system:: _entity;;
*];;
@phrase_about_planetary_system_bodies_found_1 = [В планетную систему «${_entity_name}» входят: $list{_space_body}.];;
@phrase_about_planetary_system_bodies_found_1
<- lang_ru;
<- concept_phrase_about_planetary_system_bodies_found;
=> nrel_phrase_template: @template_phrase_about_planetary_system_bodies_found_1;;

@template_phrase_about_planetary_system_bodies_found_2 = [*
