concept_phrase_about_space_class_members_not_found
<- sc_node_class;
=> nrel_main_idtf:
	[фраза об объектах класса: сведений нет] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[phrase about space class members: not found] (* <- lang_en;; *);
<= nrel_inclusion:
	concept_phrase_about_space_knowledge;;

@template_phrase_about_space_class_members_not_found_1 = [*
	concept_message _-> _message;;
	_message _-> rrel_entity:: _entity;;
	_entity _=> nrel_main_idtf:: _entity_name;;
	lang_ru _-> _entity_name;;
*];;
@phrase_about_space_class_members_not_found_1 = [В базе знаний пока нет объектов класса «${_entity_name}». Попросите наполнить базу знаний объектами этого типа — я загружу их из Wikidata.];;
@phrase_about_space_class_members_not_found_1
<- lang_ru;
<- concept_phrase_about_space_class_members_not_found;
=> nrel_phrase_template: @template_phrase_about_space_class_members_not_found_1;;
