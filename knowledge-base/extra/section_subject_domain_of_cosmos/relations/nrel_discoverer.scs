/* Первооткрыватель*: в полной базе знаний NIKA это отношение объявлено и в разделе «Медицина»; в ветке
   с одним вариантом «Космос» основные идентификаторы задаются здесь. */
nrel_discoverer
<- sc_node_non_role_relation;
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
<- antitransitive_relation;
=> nrel_main_idtf:
	[первооткрыватель*] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[discoverer*] (* <- lang_en;; *);
=> nrel_first_domain: concept_space_object;
=> nrel_second_domain: sc_node_link;
=> nrel_definitional_domain:
    ...
    (*
        <= nrel_combination:
            {
            concept_space_object;
            sc_node_link
            };;
    *);
<- rrel_key_sc_element:
    ...
    (*
    => nrel_main_idtf:
        [Опр. (первооткрыватель*)]
        (* <- lang_ru;; *);;
    <- definition;;
    <= nrel_sc_text_translation:
        ...
        (*
        -> rrel_example:
            [Первооткрыватель* - бинарное ориентированное отношение, связывающее космический
            объект с именем человека или названием коллектива, впервые обнаружившего этот объект.]
            (* <- lang_ru;; *);;
        *);;
    <= nrel_using_constants:
        {
        concept_space_object
        };;
    *);;
