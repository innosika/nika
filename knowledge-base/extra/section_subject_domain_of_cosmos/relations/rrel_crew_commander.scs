/* Ролевое отношение - подмножество отношения принадлежности.
   Оно указывает РОЛЬ элемента в множестве: здесь - какой из членов
   экипажа является его командиром.
   Системный идентификатор ролевого отношения начинается с "rrel_"
   (вместо знака "'", запрещённого в алфавите системных идентификаторов). */
rrel_crew_commander
<- sc_node_role_relation;
<- relation;
<- role_relation;
=> nrel_main_idtf:
    [командир экипажа']
    (* <- lang_ru;; *);
    [crew commander']
    (* <- lang_en;; *);
=> nrel_definitional_domain: concept_cosmonaut;
<- rrel_key_sc_element:
    ...
    (*
    => nrel_main_idtf:
        [Опр. (командир экипажа')]
        (* <- lang_ru;; *);;
    <- definition;;
    <= nrel_sc_text_translation:
        ...
        (*
        -> rrel_example:
            [Командир экипажа' - ролевое отношение, выделяющее в составе экипажа космической
            миссии того космонавта, который руководит полётом и несёт ответственность
            за выполнение программы миссии.]
            (* <- lang_ru;; *);;
        *);;
    <= nrel_using_constants:
        {
        concept_cosmonaut;
        concept_space_mission
        };;
    *);;
