nrel_located_in_constellation
<- sc_node_non_role_relation;
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
<- antitransitive_relation;
=> nrel_main_idtf:
    [расположен в созвездии*]
    (* <- lang_ru;; *);
    [located in constellation*]
    (* <- lang_en;; *);
=> nrel_first_domain: concept_space_object;
=> nrel_second_domain: concept_constellation;
=> nrel_definitional_domain:
    ...
    (*
        <= nrel_combination:
            {
            concept_space_object;
            concept_constellation
            };;
    *);
<- rrel_key_sc_element:
    ...
    (*
    => nrel_main_idtf:
        [Опр. (расположен в созвездии*)]
        (* <- lang_ru;; *);;
    <- definition;;
    <= nrel_sc_text_translation:
        ...
        (*
        -> rrel_example:
            [Расположен в созвездии* - бинарное ориентированное отношение, связывающее
            космический объект с тем созвездием, в границах которого он наблюдается
            на небесной сфере.]
            (* <- lang_ru;; *);;
        *);;
    <= nrel_using_constants:
        {
        concept_space_object;
        concept_constellation
        };;
    *);;
