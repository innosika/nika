/* Обратное к nrel_orbit по смыслу, но с более узкими доменами:
   связывает небесное тело с его естественным спутником. */
nrel_natural_satellite
<- sc_node_non_role_relation;
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
<- antitransitive_relation;
=> nrel_main_idtf:
    [естественный спутник*]
    (* <- lang_ru;; *);
    [natural satellite*]
    (* <- lang_en;; *);
=> nrel_first_domain: concept_space_object;
=> nrel_second_domain: concept_natural_satellite;
=> nrel_definitional_domain:
    ...
    (*
        <= nrel_combination:
            {
            concept_space_object;
            concept_natural_satellite
            };;
    *);
<- rrel_key_sc_element:
    ...
    (*
    => nrel_main_idtf:
        [Опр. (естественный спутник*)]
        (* <- lang_ru;; *);;
    <- definition;;
    <= nrel_sc_text_translation:
        ...
        (*
        -> rrel_example:
            [Естественный спутник* - бинарное ориентированное отношение, связывающее небесное
            тело с телом естественного происхождения, обращающимся вокруг него.]
            (* <- lang_ru;; *);;
        *);;
    <= nrel_using_constants:
        {
        concept_space_object;
        concept_natural_satellite
        };;
    *);;
